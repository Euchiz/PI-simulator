{
  "_comment": "Claude Code SessionStart hook: read the inbox, then print the lab briefing (shared indexes to reach + arm the live message watcher). The briefing text lives in one place — the `lab startup` command — so edit it there, not here. Put this in your project's .claude/settings.json; adjust `lab` to your install path.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "lab read 2>/dev/null; lab startup 2>/dev/null; true" } ] }
    ]
  }
}
