#!/usr/bin/env python3
"""lab-migrate — drain a node's sessions and re-attach them on a fresh one.

Spec: ~/lab/decisions/compute-node-mode-design.md

This half (start/precheck/status/close/force) DRAINS: it classifies every session, asks the ones
that can be reached to wrap up, and records who is safe to move. It never kills a process and never
resumes anything — `move`/`aftercheck` do that, on the NEW node.
"""
import argparse, glob, json, os, re, subprocess, sys, datetime

HOME = os.path.expanduser("~")
LAB  = os.environ.get("LAB_HOME", os.path.join(HOME, "lab"))
MIG  = os.path.join(LAB, "migrate")
WATCH= os.path.join(LAB, ".watch")
PROJ = os.path.join(HOME, ".claude", "projects")
BIN  = os.path.dirname(os.path.abspath(__file__))

def now():  return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
def die(m): print(f"lab migrate: {m}", file=sys.stderr); sys.exit(1)
def pkey(s): return re.sub(r"-+$","",re.sub(r"^-+","",re.sub(r"[^a-z0-9]+","-",(s or "").lower())))[:50]

# ---------- inputs ----------
def sessions():
    """Every session Claude Code knows about, from `claude agents --json`."""
    try:
        out = subprocess.run(["claude","agents","--json","--all"], capture_output=True, text=True, timeout=120)
        return json.loads(out.stdout or "[]")
    except Exception as e:
        die(f"could not enumerate sessions ({e}). Is `claude` on PATH?")

def transcript_for(sid):
    """Transcripts are stored per-PROJECT (keyed by cwd), so search every project dir."""
    hits = glob.glob(os.path.join(PROJ, "*", f"{sid}.jsonl"))
    return hits[0] if hits else None

def lab_agents():
    """name -> job-id, from the roster. Only these have inboxes we can message."""
    m = {}
    try:
        with open(os.path.join(LAB, ".roster.tsv")) as f:
            for line in f:
                p = line.rstrip("\n").split("\t")
                if len(p) >= 2: m[pkey(p[1])] = p[0]
    except OSError: pass
    return m

def activity(short_id):
    """What is actually RUNNING in a session, from its own state.json (on NFS -> works cross-node).
    Claude Code maintains this, so it beats process-scanning, which cannot see another node.
      inFlight.tasks / .kinds  -> running background tasks ('monitor', 'local_bash')
      fan[].kind               -> 'monitor' | 'shell' | 'todo'   (todo = a pending item, NOT running)
    """
    f = os.path.join(HOME, ".claude", "jobs", str(short_id), "state.json")
    out = {"shells":0, "monitors":0, "tasks":0, "queued":0, "state":None, "tempo":None, "labels":[]}
    try: d = json.load(open(f))
    except Exception: return out
    inf = d.get("inFlight") or {}
    out["tasks"], out["queued"] = inf.get("tasks",0) or 0, inf.get("queued",0) or 0
    out["state"], out["tempo"] = d.get("state"), d.get("tempo")
    kinds = inf.get("kinds") or []
    for x in (d.get("fan") or []):
        if not isinstance(x, dict): continue
        k = x.get("kind")
        if k == "shell":   out["shells"]   += 1; out["labels"].append("shell:"+str(x.get("label",""))[:28])
        elif k == "monitor": out["monitors"] += 1; out["labels"].append("monitor:"+str(x.get("label",""))[:28])
    if "local_bash" in kinds and out["shells"] == 0: out["shells"] = 1
    return out

def local_pids():
    """short-session-id -> pid|0, for sessions alive on THIS host. A bounded /proc read (never an
    NFS scan). Only the old node can do this, which is why verification happens THERE.

    TWO signals, unioned deliberately. Neither is complete on its own: the environ scan misses a
    session whose main process is a CLAIMED SPARE (its own environ has no CLAUDE_JOB_DIR), and the
    pty-socket scan misses sessions that are not pty-hosted here. Measured on this node: environ
    found 5, sockets found 2. We bias toward "still alive" — a false ALIVE only delays a migration,
    while a false GONE lets two sessions hold one lab identity and eat each other's inbox.
    """
    out = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit(): continue
        try: env = open(f"/proc/{pid}/environ","rb").read().decode("utf8","replace")
        except Exception: continue
        m = re.search(r"CLAUDE_JOB_DIR=([^\x00]+)", env)
        if m: out.setdefault(os.path.basename(m.group(1).rstrip("/")), int(pid))
    for sock in glob.glob("/tmp/cc-daemon-*/*/pty/*.sock") + glob.glob("/tmp/cc-daemon-*/*/spare/*.pty.sock"):
        sid = os.path.basename(sock).split(".")[0]
        if len(sid) == 8: out.setdefault(sid, 0)          # 0 = alive here, pid unknown
    return out

def watcher_alive(name):
    f = os.path.join(WATCH, f"{pkey(name)}.lock")
    try:
        pid = int(open(f).read().split()[0])
        os.kill(pid, 0); return True
    except Exception: return False

# ---------- registry ----------
def mig_dir(mid):    return os.path.join(MIG, mid)
def status_dir(mid): return os.path.join(mig_dir(mid), "status")
def current_mid():
    """The newest migration that has not been finalised."""
    if not os.path.isdir(MIG): return None
    ms = sorted(d for d in os.listdir(MIG) if os.path.isdir(os.path.join(MIG,d)))
    for m in reversed(ms):
        man = os.path.join(mig_dir(m), "manifest.json")
        if os.path.isfile(man):
            try:
                if not json.load(open(man)).get("finalised"): return m
            except Exception: pass
    return None

def write_status(mid, agent, **kw):
    os.makedirs(status_dir(mid), exist_ok=True)
    p = os.path.join(status_dir(mid), f"{pkey(agent)}.json")
    cur = {}
    if os.path.isfile(p):
        try: cur = json.load(open(p))
        except Exception: pass
    cur.update(kw); cur["agent"] = agent; cur["updated"] = now()
    tmp = f"{p}.{os.getpid()}.tmp"                 # one file per session; never a shared file
    with open(tmp,"w") as f: json.dump(cur, f, indent=2)
    os.replace(tmp, p)
    return cur

def read_all(mid):
    out = []
    for p in sorted(glob.glob(os.path.join(status_dir(mid), "*.json"))):
        try: out.append(json.load(open(p)))
        except Exception: pass
    return out

# ---------- classification ----------
def classify(s, roster):
    """-> (class, status, note, act). Never kills, never resumes; read-only."""
    name, sid = s.get("name") or s.get("id"), s.get("sessionId","")
    txt = transcript_for(sid)
    act = activity(s.get("id"))
    if not txt:
        return "unmigratable", "failed", "no transcript on disk — cannot be resumed", act
    # A running SHELL is real work in flight. A monitor is only a watcher — it dies with the node
    # harmlessly, and nearly every lab session has one armed, so monitors alone must NOT mark a
    # session busy or the whole lab would be permanently pending.
    busy = (s.get("state") == "working") or act["shells"] > 0 or act["queued"] > 0
    what = []
    if act["shells"]:   what.append(f"{act['shells']} shell")
    if act["monitors"]: what.append(f"{act['monitors']} monitor")
    detail = ", ".join(what) or "nothing running"
    if not busy:
        return "static", "closed", f"idle ({detail}) — nothing to wrap up", act
    if pkey(name) in roster and watcher_alive(name):
        return "active-watched", "pending", f"BUSY ({detail}) — reachable, wrap-up message sent", act
    return "active-unwatched", "pending", f"BUSY ({detail}) — NOT reachable, close by hand", act

WRAPUP = """TOP-PRIORITY — node termination in ~{hours}h.

The node this lab runs on is ending. Your transcript will be migrated to a new node as a new
session; your conversation and your lab identity carry over, your running processes do NOT.

Do this now, then stop:
 1. stop starting new work
 2. commit and push anything uncommitted
 3. register any dataset/tool you produced (lab data add / lab tool add) and log results as claims
 4. PRINT YOUR IN-FLIGHT SBATCH JOB IDS INTO THIS CONVERSATION so the resumed session can find them
    (they survive the node; you will not be here to collect them)
 5. close your shells and monitors
 6. run:  lab migrate close

If you do not register by the deadline you will be force-closed and may lose uncommitted work."""

# ---------- commands ----------
def cmd_start(a):
    mid = a.id or datetime.datetime.now().strftime("manual-%Y%m%d-%H%M%S")
    os.makedirs(status_dir(mid), exist_ok=True)
    man = {"migration_id": mid, "created": now(), "old_node": os.uname().nodename,
           "old_job": os.environ.get("SLURM_JOB_ID",""), "new_job": a.new_job or "",
           "deadline_hours": a.deadline_hours, "force_at_hours": a.force_at,
           "finalised": False}
    json.dump(man, open(os.path.join(mig_dir(mid),"manifest.json"),"w"), indent=2)
    print(f"migration {mid} opened  (deadline ~{a.deadline_hours}h, force at T-{a.force_at}h)")
    return cmd_precheck(argparse.Namespace(id=mid, notify=not a.no_notify, quiet=False))

def cmd_precheck(a):
    mid = a.id or current_mid() or die("no open migration — run `lab migrate start` first")
    roster = lab_agents()
    try: hours = json.load(open(os.path.join(mig_dir(mid),"manifest.json"))).get("deadline_hours",8)
    except Exception: hours = 8
    # GUARD: precheck MUST run on the host where the sessions live. watcher_alive() uses
    # os.kill(pid,0), which only answers for local pids — run it elsewhere and every session
    # silently classifies as "not reachable", so NOBODY gets a wrap-up message and everyone is
    # force-closed without warning. Observed once, when a stray test job ran precheck from a
    # compute node while the sessions were on the login node.
    _local = local_pids()
    _sess  = sessions()
    if _sess and not any(x.get("id") in _local for x in _sess):
        print(f"  ⚠ WARNING: none of the {len(_sess)} sessions are running on this host "
              f"({os.uname().nodename}).\n"
              f"    precheck can only reach sessions it shares a machine with — run it ON THE OLD "
              f"NODE, or every session will be classified unreachable and force-closed unwarned.")
    rows, notified = [], 0
    for s in _sess:
        name = s.get("name") or s.get("id")
        cls, st, note, act = classify(s, roster)
        prev = None
        p = os.path.join(status_dir(mid), f"{pkey(name)}.json")
        if os.path.isfile(p):
            try: prev = json.load(open(p))
            except Exception: pass
        # never downgrade a session that already registered itself closed/forced
        if prev and prev.get("status") in ("closed","forced") and prev.get("by") in ("self","force"):
            st, note, cls = prev["status"], prev.get("note",note), prev.get("class",cls)
        else:
            if cls == "active-watched" and getattr(a,"notify",True):
                try:
                    subprocess.run([os.path.join(BIN,"lab"),"send",pkey(name),
                                    "TOP-PRIORITY: node ending — wrap up and register Closed",
                                    WRAPUP.format(hours=hours)], capture_output=True, timeout=60)
                    notified += 1
                except Exception: pass
            write_status(mid, name, status=st, **{"class":cls}, note=note,
                         session_id=s.get("sessionId"), short_id=s.get("id"),
                         cwd=s.get("cwd"), transcript=transcript_for(s.get("sessionId","")),
                         state_at_check=s.get("state"), is_lab=pkey(name) in roster,
                         running=f"{act['shells']} shell / {act['monitors']} monitor",
                         running_labels=act["labels"],
                         by="precheck" if st!="pending" else None)
        rows.append((name, cls, st, note))

    if not getattr(a,"quiet",False):
        print(f"\n=== migration {mid} — precheck ===")
        print(f"  {'agent':<16} {'class':<18} {'status':<12} note")
        for n,c,st,note in sorted(rows, key=lambda r:(r[2]!="pending", r[0])):
            print(f"  {str(n)[:16]:<16} {c:<18} {st:<12} {note}")
        pend = [r for r in rows if r[2]=="pending"]
        hand = [r for r in rows if r[1]=="active-unwatched"]
        bad  = [r for r in rows if r[1]=="unmigratable"]
        print(f"\n  {len(rows)} session(s) · {len(pend)} pending · {notified} wrap-up message(s) sent")
        if hand:
            print("\n  ⚠ CLOSE THESE BY HAND — active with no watcher, cannot be reached automatically:")
            for n,_,_,_ in hand: print(f"      {n}")
        if bad:
            print("\n  ⚠ CANNOT BE MIGRATED — no transcript on disk:")
            for n,_,_,note in bad: print(f"      {n}  ({note})")
        print(f"\n  greenlight when pending = 0.  `lab migrate status` to re-check.")
    return 0

def cmd_status(a):
    mid = a.id or current_mid() or die("no open migration")
    rows = read_all(mid)
    n_pend = sum(1 for r in rows if r.get("status")=="pending")
    print(f"=== migration {mid} ===")
    for r in sorted(rows, key=lambda r:(r.get("status")!="pending", r.get("agent",""))):
        print(f"  {str(r.get('agent'))[:16]:<16} {r.get('status',''):<10} {r.get('class',''):<18} {r.get('note','')}")
    print(f"\n  {len(rows)} session(s), {n_pend} pending -> {'GREENLIT' if n_pend==0 else 'DRAINING'}")
    return 0 if n_pend == 0 else 2

def cmd_close(a):
    mid = a.id or current_mid() or die("no open migration")
    agent = a.agent
    if not agent:
        r = subprocess.run([os.path.join(BIN,"lab"),"name"], capture_output=True, text=True, timeout=60)
        agent = (r.stdout or "").strip()
    if not agent or "could not" in agent:
        die("cannot resolve who you are — pass --agent <name>")
    write_status(mid, agent, status="closed", by="self", note=a.note or "registered by the session itself")
    print(f"migration {mid}: {agent} registered CLOSED")
    return cmd_status(argparse.Namespace(id=mid))

def cmd_force(a):
    mid = a.id or current_mid() or die("no open migration")
    targets = [r for r in read_all(mid) if r.get("status")=="pending"]
    if a.agent: targets = [r for r in targets if pkey(r.get("agent"))==pkey(a.agent)]
    if not targets: print("nothing pending to force"); return 0
    for r in targets:
        write_status(mid, r["agent"], status="forced", by="force",
                     note=a.reason or "deadline reached; forced so the loop does not block")
        print(f"  FORCED {r['agent']} — uncommitted work in that session may be lost")
    return cmd_status(argparse.Namespace(id=mid))


SETUP_PROMPT = (
    "This session was just migrated to a new node. Run the lab-setup skill now: repair this "
    "session's lab identity, consume its inbox, ARM the live message watcher, and self-check the "
    "lab wiring. Then report the state in a few lines and STOP — do not resume any previous work "
    "and do not start anything new until asked. If the conversation above mentions in-flight "
    "sbatch job ids, list them in your report so they are not lost."
)

# ---------- the resume half: runs on the NEW node ----------
def manifest(mid):
    try: return json.load(open(os.path.join(mig_dir(mid),"manifest.json")))
    except Exception: return {}

def old_is_dead(rec, man):
    """(dead|False|None, why). Ordered by how authoritative the evidence is.

    LOCAL ABSENCE IS NOT PROOF OF DEATH. A session missing from this host's /proc may simply be
    running on a different host — login nodes rotate, and `start` records old_node as wherever it
    happened to run. Treating absence as death resumed 7 live sessions in testing, each duplicating
    a real agent's lab identity. Only positive evidence counts: Slurm says the job is gone, or the
    old host itself stamped the session.
    """
    # 1. a live local process is decisive: it is NOT dead
    here = local_pids().get(rec.get("short_id"))
    if here is not None:
        return False, f"still running on this host ({'pid '+str(here) if here else 'pty socket present'})"
    # 2. Slurm is authoritative for a job-hosted old node
    job = man.get("old_job")
    if job:
        r = subprocess.run(["squeue","-h","-j",str(job),"-o","%T"], capture_output=True, text=True, timeout=60)
        st = (r.stdout or "").strip()
        if r.returncode != 0 or not st:
            return True, f"old job {job} is no longer in the queue"
        return False, f"old job {job} is still {st} — its sessions are still alive"
    # 3. a stamp written ON the old host by `lab migrate verify-dead`
    if rec.get("process_gone") is True:
        return True, f"verified gone on {rec.get('verified_on','the old node')} at {rec.get('verified_at','?')}"
    if rec.get("process_gone") is False:
        return False, f"still running on {rec.get('verified_on','the old node')} as pid {rec.get('old_pid')}"
    # 4. absence proves nothing
    return None, ("unverified — not running HERE, but that is not proof it is dead (it may be on "
                  "another host). Run `lab migrate verify-dead` ON THE OLD NODE, or --allow-live-old")

def backup(mid, rec):
    d = os.path.join(mig_dir(mid), "backup"); os.makedirs(d, exist_ok=True)
    src = rec.get("transcript")
    if not src or not os.path.isfile(src): return None
    out = os.path.join(d, f"{pkey(rec['agent'])}-{os.path.basename(src)}.zst")
    if os.path.isfile(out): return out
    try:
        subprocess.run(["zstd","-q","-f","-o",out,src], check=True, capture_output=True, timeout=600)
        return out
    except Exception:
        out = out[:-4] + ".gz"
        with open(src,"rb") as fi, __import__("gzip").open(out,"wb") as fo: fo.writelines(fi)
        return out

def cmd_move(a):
    mid = a.id or current_mid() or die("no open migration")
    man, recs = manifest(mid), read_all(mid)
    pend = [r for r in recs if r.get("status") == "pending"]
    if pend and not a.force:
        die(f"{len(pend)} session(s) still pending — not greenlit. "
            f"`lab migrate status`, then `lab migrate force` or `move --force`")
    # HARD GUARD: move must run INSIDE the host job it is migrating into. Without this, a stray
    # `move` runs wherever you happen to be — which on 2026-08-21 meant a login node with ~700 MB
    # free, where it resumed 7 sessions and OOM'd the machine for an hour. Resuming sessions is
    # memory-heavy by nature; it must only ever happen on the allocation sized for it.
    here_job = os.environ.get("SLURM_JOB_ID", "")
    want_job = str(man.get("new_job") or "")
    if not a.dry_run and not a.force_here:
        if want_job and here_job != want_job:
            die(f"refusing to move: this migration targets host job {want_job}, but you are "
                f"{'on job '+here_job if here_job else 'NOT inside any Slurm job (a login node?)'}.\n"
                f"  Run it on the host node:  lab node enter   then re-run.\n"
                f"  Resuming sessions is memory-heavy — on a login node it takes the machine down.\n"
                f"  Override only if you are certain: --force-here")
        if not want_job and not here_job:
            die("refusing to move: not inside a Slurm job and the manifest names no host job.\n"
                "  `move` resumes sessions, which is memory-heavy — never do it on a login node.\n"
                "  Use `lab node enter` first, or --force-here if you truly mean it.")
    movable = [r for r in recs if r.get("status") in ("closed","forced")
               and r.get("transcript") and not r.get("moved_to")]
    skipped = [r for r in recs if r.get("moved_to")]
    if skipped: print(f"  {len(skipped)} already moved — skipping (move is idempotent)")
    if not movable: print("nothing to move"); return 0

    if a.dry_run:
        print(f"=== DRY RUN — migration {mid}, {len(movable)} session(s) would move onto {os.uname().nodename} ===")
        for r in sorted(movable, key=lambda r: r.get("agent","")):
            dead, why = old_is_dead(r, man)
            verdict = "WOULD MOVE" if dead is True else ("BLOCKED" if dead is False else "UNVERIFIED")
            print(f"  {verdict:<11} {r['agent']:<16} {why}")
        print("\n  nothing was resumed. Drop --dry-run to act.")
        return 0
    print(f"=== migration {mid} — moving {len(movable)} session(s) onto {os.uname().nodename} ===")
    ok = fail = 0
    for r in sorted(movable, key=lambda r: r.get("agent","")):
        agent, sid = r["agent"], r.get("session_id")
        dead, why = old_is_dead(r, man)
        if dead is False or (dead is None and not a.allow_live_old):
            print(f"  SKIP {agent}: {why}")
            write_status(mid, agent, move_error=why); fail += 1; continue
        b = backup(mid, r)                                   # §5.0 — back up BEFORE touching anything
        cwd = r.get("cwd") if r.get("cwd") and os.path.isdir(r.get("cwd")) else os.getcwd()
        cmd = ["claude","--bg","--remote-control","--resume",sid,"--name",agent]
        if not a.no_setup:
            # Re-attach the session to the lab on arrival: identity, inbox, and — the part no shell
            # can do — ARM THE WATCHER. Explicitly tells it to stop afterwards: a rotation can land
            # unattended at 3am, and a session resuming work with nobody watching is not wanted.
            cmd.append(SETUP_PROMPT)
        try:
            res = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=600)
            out = re.sub(r"\x1b\[[0-9;]*m","", (res.stdout or "") + (res.stderr or ""))
            m = re.search(r"\b([0-9a-f]{8})\b", out)
            if res.returncode != 0 or not m:
                raise RuntimeError((out.strip().splitlines() or ["no output"])[0][:160])
            new = m.group(1)
            write_status(mid, agent, moved_to=new, moved_at=now(), moved_on=os.uname().nodename,
                         backup=b, move_error=None)
            print(f"  MOVED {agent:<14} {str(sid)[:8]} -> {new}   (backup: {os.path.basename(b) if b else 'none'})")
            ok += 1
        except Exception as e:
            write_status(mid, agent, move_error=str(e)[:200]); fail += 1
            print(f"  FAIL  {agent}: {e}")
    print(f"\n  moved {ok}, failed {fail}.  Next: `lab migrate aftercheck`")
    return 0 if fail == 0 else 2

def cmd_aftercheck(a):
    mid = a.id or current_mid() or die("no open migration")
    recs = read_all(mid)
    live = {}
    for s in sessions():
        if s.get("state") in ("working","done"):
            live.setdefault(pkey(s.get("name") or ""), []).append(s.get("id"))
    moved  = [r for r in recs if r.get("moved_to")]
    forced = [r for r in recs if r.get("status") == "forced"]
    bad    = [r for r in recs if r.get("class") == "unmigratable"]
    errs   = [r for r in recs if r.get("move_error")]
    print(f"=== migration {mid} — aftercheck ===")
    print(f"  moved: {len(moved)}   forced: {len(forced)}   unmigratable: {len(bad)}   errors: {len(errs)}")
    for r in moved:
        seen = r["moved_to"] in sum(live.values(), [])
        print(f"    {r['agent']:<16} -> {r['moved_to']}  {'visible' if seen else 'NOT VISIBLE in claude agents'}")
    if forced:
        print("\n  ⚠ FORCED — these did not wrap up; uncommitted work may have been lost:")
        for r in forced: print(f"      {r['agent']}")
    if bad:
        print("\n  ⚠ NOT MIGRATED — no transcript existed:")
        for r in bad: print(f"      {r['agent']}  ({r.get('note','')})")
    if errs:
        print("\n  ⚠ ERRORS:")
        for r in errs: print(f"      {r['agent']}: {r['move_error']}")
    dupes = {n:v for n,v in live.items() if len(v) > 1 and n}
    if dupes:
        print("\n  ⚠⚠ SAME LAB NAME LIVE TWICE — they will consume each other's inbox. Close the old one:")
        for n,v in dupes.items(): print(f"      {n}: {v}")
    else:
        print("\n  ✓ no lab name is live twice")
    if not errs and not dupes and a.finalise:
        m = manifest(mid); m["finalised"] = now()
        json.dump(m, open(os.path.join(mig_dir(mid),"manifest.json"),"w"), indent=2)
        print("  migration finalised")
    print(f"\n  The lab is on {os.uname().nodename}. Run `claude agents` here, then `/lab-setup`")
    print(f"  in each session before using it. Backups: {os.path.join(mig_dir(mid),'backup')}")
    return 0 if not (errs or dupes) else 2

def cmd_verify_dead(a):
    """Run ON THE OLD NODE. Stamps each session with whether its process is actually gone."""
    mid = a.id or current_mid() or die("no open migration")
    pids, host = local_pids(), os.uname().nodename
    n_gone = n_live = 0
    for r in read_all(mid):
        sid = r.get("short_id")
        if not sid: continue
        pid = pids.get(sid)
        alive = pid is not None
        write_status(mid, r["agent"], process_gone=(not alive), old_pid=pid,
                     verified_on=host, verified_at=now())
        if alive:
            n_live += 1
            where = f"pid {pid}" if pid else "pty socket present"
            print(f"  STILL RUNNING  {r['agent']:<16} {where}   (`claude stop {sid}` to end it)")
        else:
            n_gone += 1
    print(f"\n  verified on {host}: {n_gone} gone, {n_live} still running")
    if n_live: print("  move will refuse the running ones until they are stopped — re-run this after stopping.")
    return 0 if n_live == 0 else 2

def cmd_depart(a):
    """Run ON THE OLD NODE. The whole departure: open, drain, stop, verify, hand off."""
    mid = current_mid()
    if not mid:
        host_job = a.host_job
        if not host_job:
            hf = os.path.join(LAB, "host.json")
            try: host_job = json.load(open(hf)).get("job")
            except Exception: pass
        if not host_job:
            die("no host job. Run `lab node start` first, wait for RUNNING, then re-run depart.")
        r = subprocess.run(["squeue","-h","-j",str(host_job),"-o","%T"], capture_output=True, text=True, timeout=60)
        if (r.stdout or "").strip() != "RUNNING":
            die(f"host job {host_job} is not RUNNING yet ({(r.stdout or '').strip() or 'gone'}). "
                f"Wait for it — migrating into a node that has not started loses the handoff.")
        print(f"=== departing to host job {host_job} ===")
        cmd_start(argparse.Namespace(id=None, new_job=host_job, no_notify=a.no_notify,
                                     deadline_hours=a.deadline_hours, force_at=a.force_at))
        mid = current_mid()
    else:
        print(f"=== resuming departure {mid} ===")

    pend = [r for r in read_all(mid) if r.get("status") == "pending"]
    if pend:
        print(f"\n  {len(pend)} session(s) still wrapping up:")
        for r in pend: print(f"      {r['agent']:<16} {r.get('note','')}")
        print("\n  Re-run `lab migrate depart` when they have registered, or force them:")
        print("      lab migrate force")
        return 2

    movable = [r for r in read_all(mid) if r.get("status") in ("closed","forced") and r.get("transcript")]
    pids = local_pids()
    live = [r for r in movable if pids.get(r.get("short_id"))]
    if live:
        if not a.stop_sessions:
            print(f"\n  {len(live)} session(s) are drained but their processes are STILL RUNNING here.")
            print("  They cannot be resumed elsewhere while they hold their lab identity. Either:")
            for r in live: print(f"      claude stop {r['short_id']}      # {r['agent']}")
            print("  ...or re-run:  lab migrate depart --stop-sessions")
            return 2
        me = os.path.basename(os.environ.get("CLAUDE_JOB_DIR","").rstrip("/"))
        for r in live:
            sid = r["short_id"]
            if sid == me:
                print(f"  SKIP  {r['agent']} — this is the session running depart; stop it last, by hand")
                continue
            subprocess.run(["claude","stop",sid], capture_output=True, timeout=120)
            print(f"  stopped {r['agent']} ({sid})")

    rc = cmd_verify_dead(argparse.Namespace(id=mid))
    print(f"\n=== next ===")
    print(f"  The successor host job will pull automatically once this host is gone.")
    print(f"  To pull now, on the HOST node:   lab migrate move --id {mid} && lab migrate aftercheck --id {mid}")
    return rc

def main():
    p = argparse.ArgumentParser(prog="lab migrate")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("start", help="open a migration and run precheck")
    s.add_argument("--id"); s.add_argument("--new-job", dest="new_job")
    # defaults come from lab.env (LAB_HOST_*), so the node can be retuned between rotations
    s.add_argument("--deadline-hours", dest="deadline_hours", type=int,
                   default=int(os.environ.get("LAB_HOST_WARN_HOURS", 8)))
    s.add_argument("--force-at", dest="force_at", type=int,
                   default=int(os.environ.get("LAB_HOST_FORCE_AT_HOURS", 2)))
    s.add_argument("--no-notify", action="store_true"); s.set_defaults(fn=cmd_start)
    c = sub.add_parser("precheck", help="classify sessions, notify, print the table")
    c.add_argument("--id"); c.add_argument("--no-notify", dest="notify", action="store_false")
    c.set_defaults(fn=cmd_precheck)
    t = sub.add_parser("status"); t.add_argument("--id"); t.set_defaults(fn=cmd_status)
    k = sub.add_parser("close", help="register THIS session as closed")
    k.add_argument("--id"); k.add_argument("--agent"); k.add_argument("--note"); k.set_defaults(fn=cmd_close)
    mv = sub.add_parser("move", help="resume the drained transcripts on THIS (new) node")
    mv.add_argument("--id"); mv.add_argument("--force", action="store_true", help="move even if some are pending")
    mv.add_argument("--allow-live-old", dest="allow_live_old", action="store_true",
                    help="proceed when the old host's liveness cannot be verified from here")
    mv.add_argument("--force-here", dest="force_here", action="store_true",
                    help="move even though this is not the targeted host job (dangerous on a login node)")
    mv.add_argument("--dry-run", dest="dry_run", action="store_true",
                    help="show what WOULD move and why, resuming nothing")
    mv.add_argument("--no-setup", dest="no_setup", action="store_true",
                    help="do NOT auto-run lab-setup in each resumed session (default: run it)")
    mv.set_defaults(fn=cmd_move)
    ac = sub.add_parser("aftercheck", help="verify the move and report what needs attention")
    ac.add_argument("--id"); ac.add_argument("--finalise", action="store_true"); ac.set_defaults(fn=cmd_aftercheck)
    vd = sub.add_parser("verify-dead", help="ON THE OLD NODE: stamp which session processes are gone")
    vd.add_argument("--id"); vd.set_defaults(fn=cmd_verify_dead)
    dp = sub.add_parser("depart", help="ON THE OLD NODE: open, drain, stop, verify, hand off — one command")
    dp.add_argument("--host-job", dest="host_job"); dp.add_argument("--no-notify", action="store_true")
    dp.add_argument("--stop-sessions", dest="stop_sessions", action="store_true",
                    help="actually `claude stop` the drained sessions (they keep their conversations)")
    dp.add_argument("--deadline-hours", dest="deadline_hours", type=int,
                    default=int(os.environ.get("LAB_HOST_WARN_HOURS", 8)))
    dp.add_argument("--force-at", dest="force_at", type=int,
                    default=int(os.environ.get("LAB_HOST_FORCE_AT_HOURS", 2)))
    dp.set_defaults(fn=cmd_depart)
    f = sub.add_parser("force", help="force-close stragglers so the loop cannot block")
    f.add_argument("--id"); f.add_argument("--agent"); f.add_argument("--reason"); f.set_defaults(fn=cmd_force)
    a = p.parse_args()
    sys.exit(a.fn(a) or 0)

if __name__ == "__main__":
    main()
