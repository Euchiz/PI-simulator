#!/usr/bin/env bash
# lab-node — the allocation the lab runs inside, and the rotation loop between allocations.
# Spec: ~/lab/decisions/compute-node-mode-design.md §2.1, §5.6
#
#   lab node start          submit the host job (settings from lab.env: LAB_HOST_*)
#   lab node status         where the lab lives, and how long is left
#   lab node enter          open a shell ON the host node (ssh to compute nodes is refused)
#   lab node rotate         trigger the termination sequence NOW (same path the signal takes)
#   lab node stop           cancel the host job
#
# The dying host never drives the handoff: on the pre-termination signal it only submits the
# successor and publishes the migration registry to NFS. The SUCCESSOR polls for greenlight and
# pulls. The actor is always the host that will still exist when the work lands.
set -uo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/lab-common.sh"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
HOSTF="$LAB_HOME/host.json"

PART="${LAB_HOST_PARTITION:-defq}"; CPUS="${LAB_HOST_CPUS:-8}"
MEM="${LAB_HOST_MEM:-16G}";        TIME="${LAB_HOST_TIME:-45-00:00:00}"
WARN_H="${LAB_HOST_WARN_HOURS:-8}"; FORCE_H="${LAB_HOST_FORCE_AT_HOURS:-2}"

# walltime "D-HH:MM:SS" | "HH:MM:SS" | "MM:SS" -> seconds
_walltime_s() {
  local t="$1" d=0
  case "$t" in *-*) d="${t%%-*}"; t="${t#*-}";; esac
  local IFS=:; set -- $t
  case $# in 3) echo $(( d*86400 + $1*3600 + $2*60 + $3 ));;
             2) echo $(( d*86400 + $1*60 + $2 ));;
             *) echo $(( d*86400 + ${1:-0} ));; esac
}

# Re-read LAB_HOST_* from lab.env RIGHT NOW. The host job captures its config once at start, so a
# long-running node would submit a successor using whatever was configured when IT launched — a
# 7-day host would keep spawning 7-day successors however lab.env was retuned. The unset is required
# because lab.env uses ${VAR:-default} form: without it, values already exported win and re-sourcing
# is a no-op. Only the rotation path calls this; `lab node start` keeps honouring a one-off env
# override (LAB_HOST_TIME=1-00:00:00 lab node start).
_reload_config() {
  unset LAB_HOST_PARTITION LAB_HOST_CPUS LAB_HOST_MEM LAB_HOST_TIME LAB_HOST_WARN_HOURS LAB_HOST_FORCE_AT_HOURS
  if [ -f "$LAB_HOME/lab.env" ] && bash -n "$LAB_HOME/lab.env" 2>/dev/null; then
    set -a; . "$LAB_HOME/lab.env"; set +a
  fi
  PART="${LAB_HOST_PARTITION:-defq}"; CPUS="${LAB_HOST_CPUS:-8}"
  MEM="${LAB_HOST_MEM:-16G}";        TIME="${LAB_HOST_TIME:-45-00:00:00}"
  WARN_H="${LAB_HOST_WARN_HOURS:-8}"; FORCE_H="${LAB_HOST_FORCE_AT_HOURS:-2}"
  echo "[lab-node] config for successor: $PART ${CPUS}c/${MEM} walltime=$TIME warn=T-${WARN_H}h"
}

submit() {   # -> job id on stdout. $1 = optional "successor" marker
  local warn_s="${LAB_HOST_WARN_SECONDS:-$(( WARN_H * 3600 ))}"   # seconds override: testing + short rotations
  # GUARD: if the lead is >= the walltime, Slurm fires the signal immediately and the node rotates
  # the moment it starts. Observed with a 6-minute test walltime against the default 8h lead: the
  # job submitted its successor at once. Clamp to half the walltime and say so.
  local wall_s; wall_s=$(_walltime_s "$TIME")
  if [ "$wall_s" -gt 0 ] && [ "$warn_s" -ge "$wall_s" ]; then
    warn_s=$(( wall_s / 2 ))
    echo "lab node: warning lead exceeds the walltime — clamped to ${warn_s}s (half of $TIME)" >&2
  fi
  sbatch --parsable --partition="$PART" -c "$CPUS" --mem "$MEM" -t "$TIME" \
         --job-name=lab-node --signal="B:USR1@${warn_s}" \
         -o "$LAB_HOME/node-%j.log" \
         --wrap="exec env LAB_HOME='$LAB_HOME' bash '$SELF/lab-node' _run" 2>/dev/null
}

cmd_start() {
  if [ -f "$HOSTF" ]; then
    local j; j=$(python3 -c "import json;print(json.load(open('$HOSTF')).get('job',''))" 2>/dev/null)
    if [ -n "$j" ] && squeue -h -j "$j" >/dev/null 2>&1; then
      die "a host job is already running (job $j). \`lab node status\`, or \`lab node stop\` first."
    fi
  fi
  local j; j=$(submit)
  [ -n "$j" ] || die "sbatch failed"
  # Record the job id IMMEDIATELY. _register only runs once the job starts, so without this there
  # is a blind window while it is PENDING where `lab node status`/`enter` report "no host job".
  python3 - "$HOSTF" "$j" <<'PY'
import json,sys,datetime
p,job=sys.argv[1:3]
json.dump({"job":job,"node":None,"end":None,"state":"submitted",
           "started":datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")},
          open(p,"w"),indent=2)
PY
  echo "lab node: submitted host job $j  ($PART, ${CPUS}c/${MEM}, walltime $TIME)"
  if [ -n "${LAB_HOST_WARN_SECONDS:-}" ]; then
    echo "  warning fires at T-${LAB_HOST_WARN_SECONDS}s · stragglers forced ${LAB_HOST_FORCE_GAP_SECONDS:-?}s later"
  else
    echo "  warning fires at T-${WARN_H}h · stragglers forced at T-${FORCE_H}h"
  fi
  echo "  watch it:  lab node status"
}

cmd_status() {
  [ -f "$HOSTF" ] || { echo "no host job recorded (lab node start)"; return 1; }
  python3 - "$HOSTF" <<'PY'
import json,sys,subprocess,datetime
h=json.load(open(sys.argv[1])); j=h.get("job","")
r=subprocess.run(["squeue","-h","-j",str(j),"-o","%T|%N|%L"],capture_output=True,text=True)
line=(r.stdout or "").strip()
print(f"  host job : {j}")
print(f"  node     : {h.get('node') or '(not started yet)'}   submitted {h.get('started','?')}")
if line:
    st,node,left=(line.split("|")+["","",""])[:3]
    print(f"  state    : {st} on {node}")
    print(f"  time left: {left}")
else:
    print("  state    : NOT RUNNING (finished or cancelled) — the lab is not on this node any more")
print(f"  end time : {h.get('end','?')}")
PY
}

cmd_enter() {   # open a shell ON the host node
  [ -f "$HOSTF" ] || die "no host job recorded — run \`lab node start\` first"
  local j; j=$(python3 -c "import json;print(json.load(open('$HOSTF')).get('job',''))" 2>/dev/null)
  [ -n "$j" ] || die "host.json has no job id"
  local st; st=$(squeue -h -j "$j" -o %T 2>/dev/null)
  if [ "$st" = "PENDING" ]; then die "host job $j is still queued — wait for RUNNING (\`lab node status\`)"; fi
  [ "$st" = "RUNNING" ] || die "host job $j is ${st:-gone}, not RUNNING — \`lab node status\`"
  echo "lab node: entering host job $j on $(squeue -h -j "$j" -o %N 2>/dev/null)  (exit returns you here)"
  # A daemon reported as "transient" was started by an interactive step and dies with it, taking
  # every session it parents. Say so on the way in — after the shell exits it is too late.
  if command -v claude >/dev/null 2>&1 &&
     timeout 20 claude daemon status 2>/dev/null | grep -q "origin:.*transient"; then
    echo "lab node: WARNING — the agent daemon is transient (owned by an interactive step)."
    echo "          Sessions started here will be killed when you exit this shell."
    echo "          A daemon started by the host job survives; see docs/compute-node-mode.md."
  fi
  # --overlap shares the existing allocation instead of asking for new resources; direct ssh to
  # compute nodes is refused on this cluster, so Slurm is the only door in.
  exec srun --jobid="$j" --overlap --pty bash -l
}

cmd_stop() {
  local j; j=$(python3 -c "import json;print(json.load(open('$HOSTF')).get('job',''))" 2>/dev/null)
  [ -n "$j" ] || die "no host job recorded"
  scancel "$j" && echo "lab node: cancelled $j"
}

# --- internals (run INSIDE the allocation) -----------------------------------------------
_register() {
  local endt; endt=$(scontrol show job "${SLURM_JOB_ID:-0}" 2>/dev/null | grep -o 'EndTime=[^ ]*' | cut -d= -f2)
  python3 - "$HOSTF" "${SLURM_JOB_ID:-}" "$(hostname)" "$endt" <<'PY'
import json,sys,datetime
p,job,node,end=sys.argv[1:5]
json.dump({"job":job,"node":node,"end":end,
           "started":datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")},
          open(p,"w"),indent=2)
PY
  echo "[lab-node] registered host job ${SLURM_JOB_ID:-?} on $(hostname), ends $endt"
}

_warn() {   # the pre-termination signal handler
  local lead="${LAB_HOST_WARN_SECONDS:+${LAB_HOST_WARN_SECONDS}s}"; lead="${lead:-~${WARN_H}h}"
  echo "[lab-node] $(date +%T) SIGUSR1 — $lead left. Submitting successor + opening migration."
  _reload_config                 # pick up any retune before submitting the successor
  local new; new=$(submit successor)
  echo "[lab-node] successor job: ${new:-FAILED}"
  if [ -n "$new" ]; then
    # A successor stuck in PENDING when this node dies means NOBODY pulls: transcripts are safe but
    # the lab is stranded until someone runs `move` by hand. Say so loudly and early.
    ( local w=0
      while [ $w -lt $(( WARN_H * 3600 / 2 )) ]; do
        local st; st=$(squeue -h -j "$new" -o %T 2>/dev/null)
        [ "$st" = "RUNNING" ] && { echo "[lab-node] successor $new is RUNNING — handoff is safe"; exit 0; }
        [ -z "$st" ] && { echo "[lab-node] ⚠ successor $new VANISHED from the queue — no node will pull. Run \`lab node start\` yourself."; exit 1; }
        sleep 120; w=$(( w + 120 ))
      done
      echo "[lab-node] ⚠ successor $new is STILL PENDING with half the warning window gone — the lab may be stranded. Check \`squeue\`." ) &
  fi
  "$SELF/lab" migrate start --new-job "${new:-}" \
      --deadline-hours "$WARN_H" --force-at "$FORCE_H" || true
  ( _force_at_deadline & )     # background: force stragglers so the loop cannot block
}

_force_at_deadline() {
  local gap="${LAB_HOST_FORCE_GAP_SECONDS:-$(( (WARN_H - FORCE_H) * 3600 ))}"
  sleep "$gap"
  echo "[lab-node] $(date +%T) T-${FORCE_H}h — forcing any stragglers"
  "$SELF/lab" migrate force --reason "deadline reached; node ends in ${FORCE_H}h" || true
}

_bootstrap() {   # am I a successor? if so, wait for greenlight and PULL
  local mid; mid=$(python3 - "$LAB_HOME" "${SLURM_JOB_ID:-}" <<'PY'
import json,os,sys,glob
lab,job=sys.argv[1:3]
for d in sorted(glob.glob(os.path.join(lab,"migrate","*")),reverse=True):
    m=os.path.join(d,"manifest.json")
    try: man=json.load(open(m))
    except Exception: continue
    if not man.get("finalised") and str(man.get("new_job")) == str(job):
        print(os.path.basename(d)); break
PY
)
  [ -n "$mid" ] || { echo "[lab-node] not a successor — nothing to pull"; return 0; }
  echo "[lab-node] I am the successor for migration $mid — waiting for greenlight"
  # Greenlight needs BOTH: every session registered closed/forced, AND the OLD JOB GONE.
  # A session that has "wrapped up" still has a live process until its node dies, and `move`
  # refuses to resume while the old process lives (two sessions sharing a lab name eat each
  # other's inbox). Polling on sessions alone would fire early, skip everything, and never retry.
  local oldjob; oldjob=$(python3 -c "import json;print(json.load(open('$LAB_HOME/migrate/$mid/manifest.json')).get('old_job',''))" 2>/dev/null)
  local waited=0 max=$(( (WARN_H + 2) * 3600 ))
  while [ $waited -lt $max ]; do
    local sessions_ready=0 old_gone=0
    "$SELF/lab" migrate status --id "$mid" >/dev/null 2>&1 && sessions_ready=1
    if [ -z "$oldjob" ] || ! squeue -h -j "$oldjob" >/dev/null 2>&1; then old_gone=1; fi
    if [ "$sessions_ready" = 1 ] && [ "$old_gone" = 1 ]; then
      echo "[lab-node] GREENLIT (sessions drained, old job $oldjob gone) — pulling"
      "$SELF/lab" migrate move --id "$mid" || true
      "$SELF/lab" migrate aftercheck --id "$mid" --finalise || true
      return 0
    fi
    [ $(( waited % 600 )) = 0 ] && echo "[lab-node] waiting: sessions_ready=$sessions_ready old_gone=$old_gone (${waited}s)"
    sleep 30; waited=$(( waited + 30 ))
  done
  echo "[lab-node] gave up waiting for greenlight after $((max/3600))h — run \`lab migrate move\` by hand"
}

# --- periodic work, run from the hold loop because compute nodes have no crond ---------------
# Guarded by a STAMP FILE per occurrence, not by a loop counter. A counter means "every N
# iterations since this job started", which slides a little further from the wall clock every
# rotation — fine for "every ~3 minutes", wrong for "daily" or "Monday 15:00".
_once() {   # _once <stamp-key> <command...>   -> runs at most once per key, ever
  local key="$1"; shift
  local d="$LAB_HOME/.host-cron"; mkdir -p "$d"
  local f="$d/$key"
  [ -e "$f" ] && return 0
  : > "$f"
  echo "[lab-node] $(date +%T) scheduled: $key"
  "$@" >>"$LAB_HOME/.host-cron/run.log" 2>&1 || echo "[lab-node] ⚠ $key failed (see .host-cron/run.log)"
}

_schedule_tick() {
  local today dow hour
  today=$(date +%F); dow=$(date +%u); hour=$(date +%-H)
  # daily maintenance, once the day has reached 08:00 (matches the old cron window)
  if [ "$hour" -ge 8 ]; then
    _once "daily-$today"   "$SELF/lab-daily"
    _once "data-$today"    "$SELF/lab" data maint
    _once "tool-$today"    "$SELF/lab" tool maint
    _once "know-$today"    "$SELF/lab" know maint
  fi
  # weekly meeting cadence (Mon 15:00 convene · Tue 10:00 checkin · Thu 22:00 convene)
  [ "$dow" = 1 ] && [ "$hour" -ge 15 ] && _once "convene-$today" "$SELF/lab" meeting convene
  [ "$dow" = 2 ] && [ "$hour" -ge 10 ] && _once "checkin-$today" "$SELF/lab" meeting checkin
  [ "$dow" = 4 ] && [ "$hour" -ge 22 ] && _once "convene-$today" "$SELF/lab" meeting convene
  # keep the stamp dir from growing without bound
  find "$LAB_HOME/.host-cron" -maxdepth 1 -type f -mtime +30 -delete 2>/dev/null || true
}

# The agent daemon parents every background session, so WHERE it is born decides whether sessions
# outlive a shell. Started on demand by `claude agents`, it lands in whatever `srun --pty` step
# opened the agents view — and Slurm SIGKILLs a step's entire cgroup the moment that shell exits,
# taking every session with it. Nothing in the session can defend itself: cgroup membership is fixed
# at fork, so `nohup`/`setsid` do not help, and the long-lived `extern` step's cgroup.procs is
# root-owned, so a running process cannot be moved to safety after the fact. Starting the daemon
# HERE — from the batch script — puts it in step_batch, which lasts as long as the allocation, and
# every session it goes on to parent inherits that. Interactive shells then come and go freely.
_ensure_agent_daemon() {
  # `local PATH` shadows without growing it on every loop pass; it stays exported to children.
  local PATH="$HOME/.local/bin:${LAB_NODE_BIN:+$LAB_NODE_BIN:}$PATH"
  command -v claude >/dev/null 2>&1 || return 0
  claude daemon status >/dev/null 2>&1 && return 0
  mkdir -p "$LAB_HOME/logs"
  echo "[lab-node] agent daemon is down — starting it in the batch step"
  setsid claude daemon run >>"$LAB_HOME/logs/agent-daemon.log" 2>&1 &
}

_run() {
  # EXEC matters: --wrap runs the command as a CHILD of /bin/sh, and `--signal=B:USR1` targets that
  # shell. Without `exec` the signal hits a shell with no trap and the DEFAULT action for SIGUSR1
  # terminates the job (observed: exit 0:10, killed before the handler ever ran). With `exec`, this
  # script IS the signalled process, so the trap applies.
  trap '_warn' USR1
  _register
  _bootstrap
  _ensure_agent_daemon
  echo "[lab-node] holding the allocation. Attach with: srun --jobid=${SLURM_JOB_ID:-?} --overlap --pty bash"
  # Monitoring follows the lab. memwatch/scanwatch read /proc/meminfo and local /proc — from the
  # login node they would watch an idle machine and report all-clear while the real lab is here.
  # cron cannot help: compute nodes have no crond, so the host job runs them itself.
  local i=0
  while true; do
    sleep 60 & wait $!
    i=$(( i + 1 ))
    if [ $(( i % 3 )) = 0 ]; then "$SELF/lab-memwatch"  >/dev/null 2>&1 || true; fi
    if [ $(( i % 2 )) = 0 ]; then "$SELF/lab-scanwatch" >/dev/null 2>&1 || true; fi
    if [ $(( i % 2 )) = 0 ]; then _ensure_agent_daemon; fi
    if [ $(( i % 5 )) = 0 ]; then _schedule_tick; fi
  done
}

case "${1:-}" in
  start)  cmd_start;;
  enter|attach) cmd_enter;;
  status) cmd_status;;
  stop)   cmd_stop;;
  rotate) _warn;;
  _run)   _run;;
  _register) _register;;
  *) echo "usage: lab node start|status|enter|rotate|stop"; exit 1;;
esac
