  const has=(kids[a.id]||[]).length>0;
  const tog=el('span','tog',has?'▾':'·');row.append(tog,el('span','id',a.id),el('span','ttl',a.title));
  const bg=el('span','badge',a.verdict);bg.style.background=V[a.verdict]||'#999';row.append(bg);
  if(a.evidence.length)row.append(el('span','ev',a.evidence.length+' ev'));
  if(a.pending.length)row.append(el('span','pend','● '+a.pending.length));
  row.onclick=e=>{if(e.target===tog&&has){node.classList.toggle('collapsed');tog.textContent=node.classList.contains('collapsed')?'▸':'▾';return;}if(selRow)selRow.classList.remove('sel');selRow=row;row.classList.add('sel');detail(a);};
  node.append(row);const cb=el('div','children');build(a.id,cb);node.append(cb);box.append(node);});}
function detail(a){
  const p=document.getElementById('panel');p.textContent='';
  p.append(el('h2',null,a.id+'  '+a.title));
  const v=el('div','vline');const bg=el('span','badge',a.verdict);bg.style.background=V[a.verdict]||'#999';v.append(bg);if(a.why)v.append(el('span','why','  '+a.why));p.append(v);
  if(a.updated_by)p.append(el('div','meta','verdict by '+a.updated_by+(a.updated?' · '+a.updated:'')));
  if(a.note)p.append(el('div','note',a.note));
  if(a.pending.length){const b=el('div','pendbox');b.append(el('h3',null,'Pending edits — awaiting Zac'));a.pending.forEach(q=>b.append(el('div','pi','#'+q.pid+' '+q.op+': '+q.payload+' — '+q.rationale+' (by '+q.by+')')));p.append(b);}
  if(a.history.length){p.append(el('h3',null,'Verdict history'));a.history.forEach(h=>p.append(el('div','hi',h.at+'  '+(h.old||'-')+' → '+h.new+(h.why?'  ('+h.why+')':'')+'  by '+h.by)));}
  p.append(el('h3',null,'Evidence ('+a.evidence.length+')'));
  if(!a.evidence.length)p.append(el('div','muted','none logged yet'));
  a.evidence.forEach(c=>{const d=el('div','claim'+(c.dead?' dead':''));d.append(el('div','cs',c.statement));
    d.append(el('div','cmeta','['+c.status+'] '+c.setting+(c.source?' · '+c.source:'')+(c.author?' · '+c.author:'')));
    if(c.dead&&c.reason)d.append(el('div','creason','⚠ '+c.reason+(c.successor?' → '+c.successor:'')));p.append(d);});}
const lg=document.getElementById('legend');Object.keys(V).forEach(k=>{const s=el('span');const d=el('i','dot');d.style.background=V[k];s.append(d,document.createTextNode(k));lg.append(s);});
document.getElementById('gen').textContent='· '+DATA.aims.length+' aims · generated '+DATA.generated;
if(DATA.npending){const b=document.getElementById('pbanner');b.style.display='block';b.textContent=DATA.npending+' pending tree edit(s) awaiting Zac — the ● nodes.';}
build('',document.getElementById('tree'));
</script></body></html>"""

def _fragment(full):
    # claude.ai artifacts must be PAGE-CONTENT-ONLY (the platform adds doctype/head/body). Keep the
    # <title>, <style>, and the <body> inner content; drop the doctype/html/head/body wrapper + <meta>.
    title = re.search(r"<title>.*?</title>", full, re.S)
    style = re.search(r"<style>.*?</style>", full, re.S)
    # Anchor on the REAL <body> element — the first one AFTER </head>. A naive `<body>(.*)</body>`
    # latches onto any literal "<body>" appearing earlier in CSS/JS text (a comment or a selector
    # string), silently capturing from mid-stylesheet and corrupting the fragment.
    body, low = "", full.lower()
    hend = low.find("</head>")
    m = re.search(r"<body[^>]*>", full[hend:] if hend >= 0 else full, re.I)
    if m:
        start = (hend if hend >= 0 else 0) + m.end()
        bend = low.rfind("</body>")
        body = full[start:bend] if bend > start else full[start:]
    return (title.group(0) if title else "") + (style.group(0) if style else "") + (body or full)

def cmd_aim_render(a):
    con = connect()
    aims, npend = _render_data(con)
    blob = json.dumps({"generated": now(), "npending": npend, "aims": aims}, ensure_ascii=False).replace("</", "<\\/")
    html = AIMS_HTML.replace("__DATA__", blob)
    if getattr(a, "fragment", False):
        html = _fragment(html)
        out = a.out or os.path.join(LAB, "AIMS_TREE.artifact.html")
    else:
        out = a.out or os.path.join(LAB, "AIMS_TREE.html")
    with open(out, "w", encoding="utf-8") as f: f.write(html)
    print(f"lab aim: wrote {out} ({len(aims)} aims, {npend} pending" + (", fragment" if getattr(a,'fragment',False) else "") + ")")

def cmd_maint(a):
    # daily knowledge maintenance (spec §9): incrementally re-seed new meeting/board posts (idempotent,
    # dedups) + refresh the aims-tree artifacts (full + fragment). The seed's inserts are the only writes.
    print(f"=== lab know maint {datetime.datetime.now():%F %T} ===")
    seed = os.path.join(os.path.dirname(os.path.abspath(__file__)), "lab-know-seed")
    if os.path.isfile(seed):
        subprocess.run([sys.executable, seed, "--commit"], env=dict(os.environ))
    else:
        print(f"  (lab-know-seed not found at {seed}; skipping re-seed)")
    cmd_aim_render(argparse.Namespace(out=None, fragment=False))
    cmd_aim_render(argparse.Namespace(out=None, fragment=True))
    cmd_app(argparse.Namespace(out=None, fragment=False))     # the full knowledge-map app
    cmd_app(argparse.Namespace(out=None, fragment=True))       # + its artifact-publishable fragment
    # card pointer-audit (spec §6): stat each claim.card, flag broken paths. stat only — never walks (NFS rule).
    con = connect(); total, broken = card_audit(con)
    if broken:
        print(f"  ⚠ card audit: {len(broken)}/{total} claim card pointer(s) BROKEN (file missing):")
        for cid, path in broken: print(f"      {cid} -> {path}")
    else:
        print(f"  card audit: {total} card pointer(s), all resolve.")
    nbf = con.execute("""SELECT count(*) c FROM claim WHERE kind='result' AND status='holds'
                         AND (card IS NULL OR card='') AND (card_waiver IS NULL OR card_waiver='')""").fetchone()["c"]
    if nbf: print(f"  card backfill: {nbf} holds result(s) without a card or waiver — see `lab claim review --no-card`.")

# ---------- EXPERIMENT CARDS (repo-resident markdown; the ledger stores only a pointer) ----------
CARD_SECTIONS = ("Setup", "Implementation", "Outcome", "Limitations")
SCRIPT_EXT = (".py",".sh",".r",".rscript",".ipynb",".pl",".jl",".bash",".smk",".nf",".do")
OUTPUT_EXT = (".tsv",".csv",".parquet",".npy",".npz",".png",".pdf",".svg",".bam",".h5",".hdf5",
              ".json",".txt",".bed",".vcf",".fa",".fasta",".pkl",".feather",".jsonl",".gz")
CARD_TEMPLATE = """# CARD: __TITLE__
claims: __CLAIMS__    aim: __AIM__    author: __AUTHOR__    date: __DATE__

## Question
<!-- what this experiment tests (tie to the aim) -->

## Setup
__SETTING__

## Implementation
<!-- scripts (path + git commit), env (conda env / key versions), how it was run -->

## Outcome
<!-- results + numbers; PATHS to output data/artifacts (.tsv/.parquet/.png …) -->

## Limitations
<!-- caveats, uncontrolled confounds, scope bounds, what this does NOT show -->

## Repro
<!-- exact commands to regenerate -->
"""

def _card_paths(text):
    # path-like tokens (with or without a dir) — bare version numbers etc. are extracted too but get
    # filtered out by the script/output extension sets + the existence check, so no false pass.
    return [t.strip("`'\"()<>[],;") for t in re.findall(r"[~./\w-]+\.[A-Za-z0-9]+", text)]
def _resolve(card_dir, p):
    p = os.path.expanduser(p)
    return p if os.path.isabs(p) else os.path.normpath(os.path.join(card_dir, p))

def _check_header_ids(text):
    """Resolve the claims:/aim: header against the ledger. Until this existed the header was the ONE
    field `check` trusted, so a hand-typed id that no claim ever had passed validation silently."""
    warns = []
    try: con = connect()
    except Exception: return warns                      # no DB reachable: skip, never block on it
    m = re.search(r"^\s*claims?\s*:\s*(.*)$", text, re.M)
    if m:
        # stop at the next header key on the same line (aim:/author:/date:) — the fields share a line
        val = re.split(r"\b[A-Za-z]\w*\s*:", m.group(1))[0]
        for cid in [t.strip() for t in re.split(r"[,\s]+", val) if t.strip()]:
            if not con.execute("SELECT 1 FROM claim WHERE id=?", (cid,)).fetchone():
                warns.append(f"claims: header names '{cid}', which is not a claim id in the ledger")
    # aim ids are dotted numerics; requiring a leading digit stops an EMPTY `aim:` from swallowing
    # the next key ("aim:   author: test" must not report 'author' as a missing aim)
    am = re.search(r"\baim\s*:[ \t]*(\d[\w.]*)", text)
    if am and not con.execute("SELECT 1 FROM aim WHERE id=?", (am.group(1),)).fetchone():
        warns.append(f"aim: header names '{am.group(1)}', which is not an aim id in the tree")
    return warns

def card_check(path):
    """(ok, errors, warnings) per the validation floor. stat() only — never walks a tree."""
    if not os.path.isfile(path): return False, [f"card file not found: {path}"], []
    text = open(path, encoding="utf-8", errors="replace").read()
    cdir = os.path.dirname(os.path.abspath(path)); errs, warns = [], []
    if not re.search(r"^\s*claims?\s*:", text, re.M) and not re.search(r"\baim\s*:", text):
        errs.append("missing a 'claims:' / 'aim:' header line")
    for sec in CARD_SECTIONS:
        m = re.search(rf"^#+\s*{sec}\b(.*?)(?=^#+\s|\Z)", text, re.M | re.S)
        if not m: errs.append(f"missing section: ## {sec}")
        elif len(re.sub(r"<!--.*?-->", "", m.group(1), flags=re.S).replace("—","").strip()) < 8:
            errs.append(f"section ## {sec} is empty (still the template stub)")
    for sec in ("Question", "Repro"):
        if not re.search(rf"^#+\s*{sec}\b", text, re.M): warns.append(f"recommended section absent: ## {sec}")
    warns += _check_header_ids(text)   # a claims:/aim: id that resolves to nothing is a silent lie
    paths = _card_paths(text)
    scripts = [p for p in paths if p.lower().endswith(SCRIPT_EXT)]
    outputs = [p for p in paths if p.lower().endswith(OUTPUT_EXT)]
    if not scripts: errs.append("no script path found (need ≥1, e.g. a .py/.sh in Implementation)")
    elif not any(os.path.exists(_resolve(cdir, p)) for p in scripts):
        errs.append(f"no script path resolves to a file on disk — a relative path resolves against the card's "
                    f"OWN dir ({cdir}), not any parent named in the prose; use an absolute path or one relative "
                    f"to the card. checked {len(scripts)}: {scripts[:2]}")
    if not outputs: errs.append("no output-data path found (need ≥1 DATA artifact — .tsv/.parquet/.png etc, "
                                "NOT a redirected stdout/.log — in Outcome)")
    elif not any(os.path.exists(_resolve(cdir, p)) for p in outputs):
        errs.append(f"no output path resolves to a file on disk — a relative path resolves against the card's "
                    f"OWN dir ({cdir}), not any parent named in the prose; use an absolute path or one relative "
                    f"to the card. checked {len(outputs)}: {outputs[:2]}")
    return (not errs), errs, warns

def _card_of(con, claim_id):
    r = con.execute("SELECT card FROM claim WHERE id=?", (claim_id,)).fetchone()
    return r["card"] if r else None

def card_audit(con):
    """stat each claim.card pointer; return (total, [(claim_id, path) broken]). NEVER walks a tree."""
    rows = con.execute("SELECT id, card FROM claim WHERE card IS NOT NULL AND card != ''").fetchall()
    broken = [(r["id"], r["card"]) for r in rows if not os.path.isfile(r["card"])]
    return len(rows), broken

def cmd_card_new(a):
    con = connect()
    title, claims, aim_id, setting = a.title or "", a.claim or "", a.aim or "", ""
    if a.claim:
        r = con.execute("SELECT statement, setting, aim FROM claim WHERE id=?", (a.claim,)).fetchone()
        if r:
            title = title or r["statement"]; setting = r["setting"] or ""; aim_id = aim_id or (r["aim"] or "")
    d = os.path.abspath(os.path.expanduser(a.dir)); os.makedirs(d, exist_ok=True)
    path = os.path.join(d, "CARD.md")
    if os.path.exists(path) and not a.force: die(f"{path} exists (use --force to overwrite)")
    text = (CARD_TEMPLATE.replace("__TITLE__", title[:90]).replace("__CLAIMS__", claims)
            .replace("__AIM__", aim_id).replace("__AUTHOR__", resolve_self() or "unknown")
            .replace("__DATE__", now()[:10])
            .replace("__SETTING__", setting or "<!-- data/samples/config; the claim's SETTING + what's held constant -->"))
    with open(path, "w", encoding="utf-8") as f: f.write(text)
    print(f"scaffolded {path} — fill Implementation/Outcome (real script + output paths), then: lab card check {path}")

def cmd_card_check(a):
    arg = a.target
    path = arg if os.path.isfile(arg) else _card_of(connect(), arg)
    if not path: die(f"'{arg}' is neither a card file nor a claim with a card pointer")
    ok, errs, warns = card_check(path)
    for w in warns: print(f"  warn: {w}")
    if ok: print(f"OK: {path} passes the card floor" + (f" ({len(warns)} warning)" if warns else ""))
    else:
        print(f"FAIL: {path}"); [print(f"  - {e}") for e in errs]; sys.exit(1)

def cmd_card_show(a):
    con = connect(); path = _card_of(con, a.claim_id)
    if not path: die(f"claim '{a.claim_id}' has no card")
    if not os.path.isfile(path): die(f"card pointer is broken: {path} (file missing)")
    sys.stdout.write(open(path, encoding="utf-8", errors="replace").read())

def cmd_link_card(a):
    ok, errs, warns = card_check(a.path)
    for w in warns: print(f"  warn: {w}", file=sys.stderr)
    if not ok: die("card failed `lab card check`:\n  " + "\n  ".join(errs))
    with WriteLock():
        con = connect(); get(con, a.claim_id)
        con.execute("UPDATE claim SET card=?, card_waiver=NULL, updated=? WHERE id=?",
                    (os.path.abspath(os.path.expanduser(a.path)), now(), a.claim_id)); con.commit()
    print(f"linked card -> {a.claim_id}")

def _card_gate(a):
    # 'no card, no holds' for result->holds. Returns (card_abspath|None, waiver|None) or dies.
    if getattr(a, "card", None):
        ok, errs, warns = card_check(a.card)
        for w in warns: print(f"  warn: {w}", file=sys.stderr)
        if not ok: die("card failed `lab card check` — fix it, or use --no-card '<reason>':\n  " + "\n  ".join(errs))
        return os.path.abspath(os.path.expanduser(a.card)), None
    if getattr(a, "no_card", None): return None, a.no_card
    die("'no card, no holds': promoting a RESULT to `holds` needs --card <CARD.md> (passing `lab card check`)\n"
        "  or --no-card '<reason>' (recorded). Insights/lessons/decisions/facts are exempt; retraction never needs one.")

def build_parser():
    p = argparse.ArgumentParser(prog="lab claim", description="Lab Knowledge Map / claims ledger")
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add"); a.set_defaults(fn=cmd_add)
    a.add_argument("--statement", required=True); a.add_argument("--detail")
    a.add_argument("--kind", required=True); a.add_argument("--status", default="open")
    a.add_argument("--setting", required=True); a.add_argument("--evidence")
    a.add_argument("--status-reason", dest="status_reason", help="why the current status (e.g. retraction reason)")
    # `branch` the COLUMN survives the deprecated branch TABLE as a free-text TOPIC tag
    a.add_argument("--branch", "--topic", dest="branch",
                   help="free-text TOPIC tag (caller / wetlab / clinical …); --branch is the old name")
    a.add_argument("--source"); a.add_argument("--author")
    a.add_argument("--date"); a.add_argument("--id"); a.add_argument("--verified", action="store_true")
    a.add_argument("--verified-how", dest="verified_how")
    a.add_argument("--supersedes"); a.add_argument("--confounded-by", dest="confounded_by")

    f = sub.add_parser("find"); f.set_defaults(fn=cmd_find)
    f.add_argument("query"); f.add_argument("--current-only", action="store_true", dest="current_only")

    s = sub.add_parser("show"); s.set_defaults(fn=cmd_show); s.add_argument("id")

    l = sub.add_parser("list"); l.set_defaults(fn=cmd_list)
    for opt in ("status","kind","author"): l.add_argument(f"--{opt}")
    l.add_argument("--branch", "--topic", dest="branch", help="filter by TOPIC tag (e.g. caller)")
    l.add_argument("--all", action="store_true")

    r = sub.add_parser("retract"); r.set_defaults(fn=cmd_retract)
    r.add_argument("id"); r.add_argument("--reason"); r.add_argument("--superseded-by", dest="superseded_by")

    c = sub.add_parser("confirm"); c.set_defaults(fn=cmd_confirm)
    c.add_argument("id"); c.add_argument("--status", required=True); c.add_argument("--reason")
    c.add_argument("--card"); c.add_argument("--no-card", dest="no_card")   # 'no card, no holds' gate

    lc = sub.add_parser("link-card"); lc.add_argument("claim_id"); lc.add_argument("path"); lc.set_defaults(fn=cmd_link_card)

    cd = sub.add_parser("card"); cds = cd.add_subparsers(dest="cardcmd", required=True)
    cn = cds.add_parser("new"); cn.add_argument("dir"); cn.add_argument("--claim"); cn.add_argument("--aim")
    cn.add_argument("--title"); cn.add_argument("--force", action="store_true"); cn.set_defaults(fn=cmd_card_new)
    cc = cds.add_parser("check"); cc.add_argument("target", help="a CARD.md path or a claim-id"); cc.set_defaults(fn=cmd_card_check)
    cs = cds.add_parser("show"); cs.add_argument("claim_id"); cs.set_defaults(fn=cmd_card_show)

    rv = sub.add_parser("review"); rv.add_argument("--no-card", dest="no_card", action="store_true",
        help="list holds RESULT claims lacking a card AND a waiver (the backfill queue)")
    rv.set_defaults(fn=cmd_review)
    sub.add_parser("facts").set_defaults(fn=cmd_facts)
    sub.add_parser("maint").set_defaults(fn=cmd_maint)   # `lab know maint` (daily cron: re-seed + render)

    lk = sub.add_parser("link"); lk.set_defaults(fn=cmd_link)
    lk.add_argument("src"); lk.add_argument("rel"); lk.add_argument("dst"); lk.add_argument("--note")

    b = sub.add_parser("branch"); b.set_defaults(fn=cmd_branch)
    b.add_argument("bcmd", choices=["list","show","set","map"]); b.add_argument("name", nargs="?")
    b.add_argument("--status"); b.add_argument("--mechanism"); b.add_argument("--end-condition", dest="end_condition")

    am = sub.add_parser("aim"); ams = am.add_subparsers(dest="aimcmd", required=True)
    at = ams.add_parser("tree"); at.add_argument("--compact", action="store_true")
    at.add_argument("--why", action="store_true", help="append verdict-why on concluded verdicts (for the injection)")
    at.set_defaults(fn=cmd_aim_tree)
    ash = ams.add_parser("show"); ash.add_argument("id"); ash.set_defaults(fn=cmd_aim_show)
    al = ams.add_parser("log"); al.add_argument("id"); al.add_argument("--result", required=True)
    al.add_argument("--setting", required=True); al.add_argument("--evidence"); al.add_argument("--source")
    al.add_argument("--status"); al.add_argument("--date")
    al.add_argument("--topic", "--branch", dest="branch", help="free-text TOPIC tag (e.g. caller)")
    al.add_argument("--card"); al.add_argument("--no-card", dest="no_card")   # 'no card, no holds' gate
    al.set_defaults(fn=cmd_aim_log)
    aln = ams.add_parser("link"); aln.add_argument("claim_id"); aln.add_argument("aim_id"); aln.set_defaults(fn=cmd_aim_link)
    apr = ams.add_parser("propose"); apr.add_argument("op", choices=list(AIM_OPS)); apr.add_argument("id")
    apr.add_argument("--title"); apr.add_argument("--verdict"); apr.add_argument("--why"); apr.add_argument("--note")
    apr.add_argument("--rationale", required=True); apr.set_defaults(fn=cmd_aim_propose)
    ams.add_parser("pending").set_defaults(fn=cmd_aim_pending)
    aap = ams.add_parser("approve"); aap.add_argument("pid", type=int); aap.add_argument("--by", required=True)
    aap.add_argument("--note"); aap.set_defaults(fn=cmd_aim_approve)
    arj = ams.add_parser("reject"); arj.add_argument("pid", type=int); arj.add_argument("--by", required=True)
    arj.add_argument("--note"); arj.set_defaults(fn=cmd_aim_reject)
    ast = ams.add_parser("set"); ast.add_argument("id"); ast.add_argument("--verdict"); ast.add_argument("--why")
    ast.add_argument("--approved-by", dest="approved_by"); ast.set_defaults(fn=cmd_aim_set)
    asd = ams.add_parser("seed"); asd.add_argument("--file"); asd.add_argument("--commit", action="store_true")
    asd.set_defaults(fn=cmd_aim_seed)
    ex = sub.add_parser("export"); ex.add_argument("--out"); ex.add_argument("--compact", action="store_true")
    ex.set_defaults(fn=cmd_export)
    ap = sub.add_parser("app"); ap.add_argument("--out"); ap.add_argument("--fragment", action="store_true")
    ap.set_defaults(fn=cmd_app)

    arn = ams.add_parser("render"); arn.add_argument("--out")
    arn.add_argument("--fragment", action="store_true", help="page-content-only (for claude.ai artifacts)")
    arn.set_defaults(fn=cmd_aim_render)
    return p

def main(argv):
    # `lab facts` / `lab branch` dispatch here too — normalize so argparse sees the subcommand
    args = build_parser().parse_args(argv)
    args.fn(args)

if __name__ == "__main__":
    main(sys.argv[1:])
