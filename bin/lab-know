#!/usr/bin/env python3
"""lab-know — Lab Knowledge Map / claims ledger (engine for `lab claim|branch|facts`).

A claims ledger / experiment knowledge-graph: every result, insight, null, decision,
method-lesson and settled-fact is a NODE carrying its SETTING, STATUS, provenance and
typed EDGES (retracts/supersedes/confounded_by/...). The #1 correctness property is
STATUS-AWARE retrieval — a read NEVER returns a retracted/superseded claim as current.

Mirrors lab-data's proven choices: SQLite single file (~/lab/knowledge.db), FTS5, flock
write-mutex, rollback-journal (NFS-safe, no WAL), maintenance off the write path.
Companion to (not a replacement for) `lab data` (find verified X) and git (code/artifacts).
"""
import sqlite3, sys, os, re, argparse, datetime, hashlib, json, subprocess

HOME   = os.path.expanduser("~")
LAB    = os.environ.get("LAB_HOME", os.path.join(HOME, "lab"))
DB     = os.path.join(LAB, "knowledge.db")
LOCK   = os.path.join(LAB, ".knowledge.lock")
ROSTER = os.path.join(LAB, ".roster.tsv")

KINDS    = ("result", "insight", "decision", "settled-fact", "method-lesson")
STATUSES = ("open", "holds", "null", "retracted", "superseded", "confounded")
RELS     = ("retracts", "supersedes", "confounded_by", "refines", "contradicts",
            "replicates", "depends_on", "part_of")
DEAD     = ("retracted", "superseded")   # excluded from the primary (current) set

def now(): return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
def die(msg, code=1): print(f"lab claim: {msg}", file=sys.stderr); sys.exit(code)

def slug(s):
    s = re.sub(r"[^a-z0-9]+", "-", (s or "").lower()).strip("-")
    return s[:40] or "claim"

def pkey(s):   # roster/name normalizer, matching lab-data
    return re.sub(r"-+$", "", re.sub(r"^-+", "", re.sub(r"[^a-z0-9]+", "-", (s or "").lower())))[:50]

def resolve_self():   # who is calling — mirror lab-data: state.json name, roster-by-jobid, then LAB_FROM
    jd  = os.environ.get("CLAUDE_JOB_DIR", "")
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    for c in [os.path.join(jd, "state.json") if jd else "",
              os.path.join(os.path.dirname(jd), "state.json") if jd else "",
              os.path.join(HOME, ".claude", "jobs", sid.split("-")[0], "state.json") if sid else ""]:
        if c and os.path.isfile(c):
            try:
                n = pkey(json.load(open(c)).get("name", ""))
                if n: return n
            except Exception: pass
    m = re.search(r"/jobs/([0-9a-f]+)", jd)   # roster fallback: jobid -> current agent name
    if m:
        try:
            with open(ROSTER) as f:
                for line in f:
                    p = line.rstrip("\n").split("\t")
                    if len(p) >= 2 and p[0] == m.group(1): return pkey(p[1])
        except Exception: pass
    return pkey(os.environ.get("LAB_FROM", ""))

def mkid(con, statement, setting):
    base = slug(statement)
    h = hashlib.sha1(f"{statement}|{setting}|{now()}".encode()).hexdigest()[:4]
    cand = f"{base}-{h}"
    n = 1
    while con.execute("SELECT 1 FROM claim WHERE id=?", (cand,)).fetchone():
        n += 1; cand = f"{base}-{h}{n}"
    return cand

def connect():
    con = sqlite3.connect(DB, timeout=30)
    con.row_factory = sqlite3.Row
    con.execute("PRAGMA journal_mode=DELETE")   # rollback journal — NFS-safe (no WAL/-shm mmap)
    con.execute("PRAGMA busy_timeout=30000")
    con.execute("PRAGMA foreign_keys=ON")
    ensure_schema(con)
    return con

FTS_REBUILD = """
    DROP TRIGGER IF EXISTS claim_ai; DROP TRIGGER IF EXISTS claim_ad; DROP TRIGGER IF EXISTS claim_au;
    DROP TABLE IF EXISTS claim_fts;
    CREATE VIRTUAL TABLE claim_fts USING fts5(
      statement, detail, setting, evidence, aim, content='claim', content_rowid='rowid');
    CREATE TRIGGER claim_ai AFTER INSERT ON claim BEGIN
      INSERT INTO claim_fts(rowid,statement,detail,setting,evidence,aim)
      VALUES (new.rowid,new.statement,new.detail,new.setting,new.evidence,new.aim);
    END;
    CREATE TRIGGER claim_ad AFTER DELETE ON claim BEGIN
      INSERT INTO claim_fts(claim_fts,rowid,statement,detail,setting,evidence,aim)
      VALUES ('delete',old.rowid,old.statement,old.detail,old.setting,old.evidence,old.aim);
    END;
    CREATE TRIGGER claim_au AFTER UPDATE ON claim BEGIN
      INSERT INTO claim_fts(claim_fts,rowid,statement,detail,setting,evidence,aim)
      VALUES ('delete',old.rowid,old.statement,old.detail,old.setting,old.evidence,old.aim);
      INSERT INTO claim_fts(rowid,statement,detail,setting,evidence,aim)
      VALUES (new.rowid,new.statement,new.detail,new.setting,new.evidence,new.aim);
    END;
    INSERT INTO claim_fts(rowid,statement,detail,setting,evidence,aim)
      SELECT rowid,statement,detail,setting,evidence,aim FROM claim;
"""

def ensure_schema(con):
    con.executescript("""
    CREATE TABLE IF NOT EXISTS claim(
      id TEXT PRIMARY KEY,
      statement TEXT NOT NULL,
      detail TEXT,
      kind TEXT NOT NULL,
      status TEXT NOT NULL DEFAULT 'open',
      setting TEXT NOT NULL,                 -- REQUIRED: the conditions/config that produced it
      evidence TEXT,
      status_reason TEXT,                    -- why the current status (retraction/confound note)
      branch TEXT,
      source TEXT,                           -- meeting:.. / commit:.. / run:.. / artifact:..
      author TEXT,
      date TEXT,                             -- ISO date of the result
      verified INTEGER DEFAULT 0, verified_how TEXT,
      created TEXT NOT NULL, updated TEXT NOT NULL);
    CREATE TABLE IF NOT EXISTS edge(
      src TEXT NOT NULL, rel TEXT NOT NULL, dst TEXT NOT NULL, note TEXT, created TEXT NOT NULL,
      PRIMARY KEY (src, rel, dst));
    CREATE TABLE IF NOT EXISTS branch(
      name TEXT PRIMARY KEY, status TEXT NOT NULL DEFAULT 'open',
      mechanism TEXT, end_condition TEXT, updated_by TEXT, updated TEXT NOT NULL);
    -- AIMS TREE layer: aims are the prescriptive program; claims (with claim.aim set) are the
    -- evidence log under each. Dotted id IS the hierarchy (parent = id minus last segment).
    CREATE TABLE IF NOT EXISTS aim(
      id TEXT PRIMARY KEY, title TEXT, note TEXT,
      verdict TEXT NOT NULL DEFAULT 'proposed', verdict_why TEXT, updated_by TEXT, updated TEXT);
    CREATE TABLE IF NOT EXISTS aim_history(          -- append-only verdict/title change log
      hid INTEGER PRIMARY KEY AUTOINCREMENT, aim_id TEXT NOT NULL,
      old_verdict TEXT, new_verdict TEXT, why TEXT, by_who TEXT, at TEXT NOT NULL);
    CREATE TABLE IF NOT EXISTS aim_pending(          -- approval queue: propose -> approve/reject -> apply
      pid INTEGER PRIMARY KEY AUTOINCREMENT, op TEXT NOT NULL, aim_id TEXT, payload TEXT,
      proposed_by TEXT, proposed_at TEXT, rationale TEXT,
      status TEXT NOT NULL DEFAULT 'pending', decided_by TEXT, decided_at TEXT, decision_note TEXT);
    CREATE INDEX IF NOT EXISTS ix_claim_status ON claim(status);
    CREATE INDEX IF NOT EXISTS ix_claim_kind   ON claim(kind);
    CREATE INDEX IF NOT EXISTS ix_claim_branch ON claim(branch);
    CREATE INDEX IF NOT EXISTS ix_edge_dst ON edge(dst);
    """)
    # aim migration: claim.aim column (must exist BEFORE the FTS references new.aim)
    ccols = [r[1] for r in con.execute("PRAGMA table_info(claim)")]
    if "aim" not in ccols:
        con.execute("ALTER TABLE claim ADD COLUMN aim TEXT")
    # experiment-card pointers: card = absolute path to the CARD.md; card_waiver = --no-card reason
    if "card" not in ccols:        con.execute("ALTER TABLE claim ADD COLUMN card TEXT")
    if "card_waiver" not in ccols: con.execute("ALTER TABLE claim ADD COLUMN card_waiver TEXT")
    con.execute("CREATE INDEX IF NOT EXISTS ix_claim_aim ON claim(aim)")
    con.execute("CREATE INDEX IF NOT EXISTS ix_aimhist ON aim_history(aim_id)")
    ft = con.execute("SELECT sql FROM sqlite_master WHERE name='claim_fts'").fetchone()
    if not ft or "aim" not in (ft[0] or ""):     # (re)build FTS if missing or missing the aim column
        con.executescript(FTS_REBUILD)
    con.commit()

class WriteLock:
    def __enter__(self):
        os.makedirs(LAB, exist_ok=True)
        self.f = open(LOCK, "w"); import fcntl; fcntl.flock(self.f, fcntl.LOCK_EX); return self
    def __exit__(self, *a):
        import fcntl; fcntl.flock(self.f, fcntl.LOCK_UN); self.f.close()

def get(con, cid):
    r = con.execute("SELECT * FROM claim WHERE id=?", (cid,)).fetchone()
    if not r: die(f"no claim '{cid}'")
    return r

def successor(con, cid):
    """the live claim that supersedes cid, if any (NEWID supersedes OLDID)."""
    r = con.execute("SELECT src FROM edge WHERE dst=? AND rel='supersedes'", (cid,)).fetchone()
    return r["src"] if r else None

def badge(st): return st.upper()

def fmt_hit(con, r, verbose=False):
    line = f"  [{badge(r['status'])}] {r['id']}  {r['statement']}"
    sub = f"      setting: {r['setting']}"
    if r["branch"]: sub += f"  · branch: {r['branch']}"
    meta = "      " + " · ".join(x for x in (r["kind"], r["source"], r["date"], r["author"]) if x)
    out = [line, sub, meta]
    if r["card"]:                    out.append(f"      card: {r['card']}")
    elif r["card_waiver"]:           out.append(f"      card: waived — {r['card_waiver']}")
    elif r["kind"] == "result" and r["status"] == "holds": out.append("      card: none")
    if r["status"] != "holds":
        why = r["status_reason"] or ""
        succ = successor(con, r["id"])
        tail = f"      ⚠ {r['status']}"
        if why: tail += f": {why}"
        if succ: tail += f"  → live successor: {succ}"
        out.append(tail)
    return "\n".join(out)

# ---------- reads (status-aware) ----------
def fts_ids(con, q):
    terms = " ".join(f'"{t}"' for t in re.findall(r"\w+", q))
    if not terms: return []
    rows = con.execute("SELECT c.id FROM claim_fts f JOIN claim c ON c.rowid=f.rowid "
                       "WHERE claim_fts MATCH ? ORDER BY rank", (terms,)).fetchall()
    return [r["id"] for r in rows]

def cmd_find(a):
    con = connect()
    ids = fts_ids(con, a.query)
    if not ids:
        print("(no matching claims)"); return
    current = [i for i in ids if get(con, i)["status"] not in DEAD]
    dead    = [i for i in ids if get(con, i)["status"] in DEAD]
    # within CURRENT, read confirmed facts first: holds/settled above open (stable, keeps FTS rank
    # within each group) so a fresh seed's many unconfirmed [OPEN] rows don't bury the verified ones.
    crank = {"holds": 0, "null": 1, "confounded": 2, "open": 3}
    current.sort(key=lambda i: crank.get(get(con, i)["status"], 3))
    print(f"CURRENT claims matching '{a.query}':")
    if current:
        for i in current: print(fmt_hit(con, get(con, i)))
    else:
        print("  (none current)")
    if dead and not a.current_only:
        print("\nnot current (shown so you don't re-cite them):")
        for i in dead:
            r = get(con, i); succ = successor(con, i)
            s = f"  [{badge(r['status'])}] {r['id']}  ~~{r['statement']}~~"
            if r["status_reason"]: s += f"  ({r['status_reason']})"
            if succ: s += f"  → live: {succ}"
            print(s)

def cmd_show(a):
    con = connect(); r = get(con, a.id)
    print(f"[{badge(r['status'])}] {r['id']}")
    print(f"  {r['statement']}")
    for k in ("kind","setting","evidence","branch","aim","source","author","date","status_reason"):
        if r[k]: print(f"  {k:<8}: {r[k]}")
    if r["card"]:        print(f"  card    : {r['card']}" + ("" if os.path.isfile(r["card"]) else "   ⚠ MISSING"))
    elif r["card_waiver"]: print(f"  card    : waived — {r['card_waiver']}")
    if r["verified"]: print(f"  verified: yes — {r['verified_how'] or ''}")
    if r["detail"]: print(f"  detail  : {r['detail']}")
    out = con.execute("SELECT rel,dst,note FROM edge WHERE src=? ORDER BY rel", (a.id,)).fetchall()
    inc = con.execute("SELECT rel,src,note FROM edge WHERE dst=? ORDER BY rel", (a.id,)).fetchall()
    if out:
        print("  edges out:")
        for e in out: print(f"    -{e['rel']}-> {e['dst']}" + (f"  ({e['note']})" if e['note'] else ""))
    if inc:
        print("  edges in:")
        for e in inc: print(f"    <-{e['rel']}- {e['src']}" + (f"  ({e['note']})" if e['note'] else ""))

def cmd_list(a):
    con = connect()
    q = "SELECT * FROM claim WHERE 1=1"; args = []
    if a.branch: q += " AND branch=?"; args.append(a.branch)
    if a.status: q += " AND status=?"; args.append(a.status)
    if a.kind:   q += " AND kind=?";   args.append(a.kind)
    if a.author: q += " AND author=?"; args.append(a.author)
    if not a.all and not a.status:
        q += " AND status NOT IN ('retracted','superseded')"   # status-aware default
    q += " ORDER BY updated DESC"
    rows = con.execute(q, args).fetchall()
    if not rows: print("(no claims)"); return
    for r in rows: print(f"  [{badge(r['status'])}] {r['id']:<28} {r['statement'][:70]}")
    print(f"  — {len(rows)} claim(s)")

def cmd_facts(a):
    con = connect()
    rows = con.execute("SELECT * FROM claim WHERE kind='settled-fact' AND status='holds' "
                       "ORDER BY updated DESC").fetchall()
    print("SETTLED FACTS (kind=settled-fact, status=holds) — what we know for sure:")
    if not rows: print("  (none yet — settled-facts need a curation pass; see the seed notes)"); return
    for r in rows:
        print(f"  · {r['statement']}")
        if r["setting"]: print(f"      under: {r['setting']}")

def cmd_review(a):
    """batch view of auto-extracted / unconfirmed claims (status=open) for a human to confirm.
    --no-card: instead list holds RESULT claims lacking BOTH a card and a waiver (the backfill queue)."""
    con = connect()
    if getattr(a, "no_card", False):
        rows = con.execute("""SELECT * FROM claim WHERE kind='result' AND status='holds'
                              AND (card IS NULL OR card='') AND (card_waiver IS NULL OR card_waiver='')
                              ORDER BY updated DESC""").fetchall()
        if not rows:
            print("(every holds RESULT has a card or a recorded waiver — nothing to backfill)"); return
        print(f"HOLDS results WITHOUT a card ({len(rows)}) — backfill the load-bearing ones at your pace:")
        print("  attach:  lab claim link-card <id> <CARD.md>   ·   waive:  lab claim confirm is past; use link-card or a note")
        for r in rows:
            print(f"  [{r['status'].upper()}] {r['id']}  {r['statement']}")
            print(f"      setting: {r['setting']}  · {(r['aim'] or 'no-aim')} · {r['author'] or ''} {r['date'] or ''}")
        return
    rows = con.execute("SELECT * FROM claim WHERE status='open' ORDER BY created DESC").fetchall()
    if not rows: print("(no open/unconfirmed claims — nothing to review)"); return
    print(f"OPEN / unconfirmed claims to review ({len(rows)}): confirm with `lab claim confirm <id> --status ...`")
    for r in rows:
        print(f"  [OPEN] {r['id']}  {r['statement']}")
        print(f"      setting: {r['setting']}  · {r['source'] or ''} {r['date'] or ''}")

# ---------- writes (flock + txn) ----------
def add_edge(con, src, rel, dst, note=None):
    if rel not in RELS: die(f"unknown rel '{rel}' (of {RELS})")
    con.execute("INSERT OR REPLACE INTO edge(src,rel,dst,note,created) VALUES (?,?,?,?,?)",
                (src, rel, dst, note, now()))

def cmd_add(a):
    if a.kind not in KINDS: die(f"kind must be one of {KINDS}")
    if a.status not in STATUSES: die(f"status must be one of {STATUSES}")
    if not a.setting: die("--setting is REQUIRED (the conditions/config that produced this claim)")
    with WriteLock():
        con = connect()
        cid = a.id or mkid(con, a.statement, a.setting)
        if con.execute("SELECT 1 FROM claim WHERE id=?", (cid,)).fetchone(): die(f"id '{cid}' exists")
        t = now()
        con.execute("""INSERT INTO claim(id,statement,detail,kind,status,setting,evidence,status_reason,
                       branch,source,author,date,verified,verified_how,created,updated)
                       VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                    (cid, a.statement, a.detail, a.kind, a.status, a.setting, a.evidence, a.status_reason,
                     a.branch, a.source, a.author or resolve_self() or "unknown", a.date,
                     1 if a.verified else 0, a.verified_how, t, t))
        if a.supersedes:
            get(con, a.supersedes)
            add_edge(con, cid, "supersedes", a.supersedes, "superseded on add")
            con.execute("UPDATE claim SET status='superseded', status_reason=?, updated=? WHERE id=?",
                        (f"superseded by {cid}", t, a.supersedes))
        if a.confounded_by:
            con.execute("UPDATE claim SET status='confounded', status_reason=?, updated=? WHERE id=?",
                        (a.confounded_by, t, cid))
        con.commit()
    print(f"added claim {cid}")

def cmd_retract(a):
    with WriteLock():
        con = connect(); get(con, a.id); t = now()
        new_status = "superseded" if a.superseded_by else "retracted"
        reason = a.reason or ("superseded" if a.superseded_by else "retracted")
        con.execute("UPDATE claim SET status=?, status_reason=?, updated=? WHERE id=?",
                    (new_status, reason, t, a.id))
        if a.superseded_by:
            get(con, a.superseded_by)
            add_edge(con, a.superseded_by, "supersedes", a.id, a.reason)
        con.commit()
    print(f"claim {a.id} -> {new_status}" + (f" (superseded by {a.superseded_by})" if a.superseded_by else ""))

def cmd_confirm(a):
    if a.status not in STATUSES: die(f"status must be one of {STATUSES}")
    con0 = connect(); r0 = con0.execute("SELECT kind,status FROM claim WHERE id=?", (a.id,)).fetchone()
    if not r0: die(f"no claim '{a.id}'")
    card, waiver = None, None
    if a.status == "holds" and r0["kind"] == "result":   # 'no card, no holds' — results only
        card, waiver = _card_gate(a)
    with WriteLock():
        con = connect(); r = get(con, a.id)
        if r["status"] != "open":
            # Name the escape route. Anyone who triaged BEFORE cards existed lands here holding a card
            # and no obvious verb; a bare "confirm is for open claims" reads as "no path exists at all".
            hint = (f"\n  To attach a card to an already-'{r['status']}' claim (a card attach is not a"
                    f" status change, so it needs no re-gating):\n      lab claim link-card {a.id} <CARD.md>"
                    ) if getattr(a, "card", None) else ""
            die(f"claim {a.id} is '{r['status']}', not 'open' — confirm is for unconfirmed "
                f"auto-extracted claims{hint}")
        con.execute("UPDATE claim SET status=?, status_reason=?, card=COALESCE(?,card), card_waiver=?, updated=? WHERE id=?",
                    (a.status, a.reason, card, waiver, now(), a.id))
        con.commit()
    print(f"claim {a.id} confirmed -> {a.status}" +
          (f"  (card: {os.path.basename(card)})" if card else f"  (no-card: {waiver})" if waiver else ""))

def cmd_link(a):
    with WriteLock():
        con = connect(); get(con, a.src)
        add_edge(con, a.src, a.rel, a.dst, a.note); con.commit()
    print(f"edge {a.src} -{a.rel}-> {a.dst}")

# ---------- branches ----------
def _status_counts(con, name):
    return dict((x["status"], x["c"]) for x in con.execute(
        "SELECT status,count(*) c FROM claim WHERE branch=? GROUP BY status", (name,)).fetchall())

def _uncurated_branches(con):
    # branch VALUES referenced by claims but with no branch record — so a branch that HAS claims is
    # never invisible (registry rule: don't let coverage be silent). Returns [(name, counts_dict)].
    rows = con.execute("""SELECT branch AS name, count(*) n FROM claim
                          WHERE branch IS NOT NULL AND branch != ''
                            AND branch NOT IN (SELECT name FROM branch)
                          GROUP BY branch ORDER BY branch""").fetchall()
    return [(r["name"], _status_counts(con, r["name"])) for r in rows]

BRANCH_DEPRECATED = (
    "note: `lab branch` is DEPRECATED (2026-08-20) — it still works, nothing was deleted.\n"
    "  Aims are the organising structure: `lab aim tree` · `lab aim log <id> --result …`.\n"
    "  The branch TABLE never connected to anything (every row had zero claims); the seeder no\n"
    "  longer regenerates it. `claim.branch` survives as a free-text TOPIC tag: `--topic <name>`.")

def cmd_branch(a):
    print(BRANCH_DEPRECATED, file=sys.stderr)   # deprecate, don't delete — the verbs keep resolving
    con = connect()
    if a.bcmd == "list":
        rows = con.execute("SELECT * FROM branch ORDER BY status, name").fetchall()
        for r in rows: print(f"  [{r['status']:<6}] {r['name']:<28} {(r['mechanism'] or '')[:60]}")
        unc = _uncurated_branches(con)
        for name, cs in unc:
            print(f"  [uncur.] {name:<28} (no branch record — {' '.join(f'{k}:{v}' for k,v in cs.items())})")
        if not rows and not unc: print("  (no branches)")
    elif a.bcmd == "show":
        r = con.execute("SELECT * FROM branch WHERE name=?", (a.name,)).fetchone()
        if not r: die(f"no branch '{a.name}'")
        print(f"[{r['status']}] {r['name']}")
        for k in ("mechanism","end_condition","updated_by","updated"):
            if r[k]: print(f"  {k}: {r[k]}")
        cs = con.execute("SELECT status,count(*) c FROM claim WHERE branch=? GROUP BY status", (a.name,)).fetchall()
        if cs: print("  claims: " + ", ".join(f"{x['status']}={x['c']}" for x in cs))
    elif a.bcmd == "set":
        with WriteLock():
            con = connect(); t = now()
            con.execute("""INSERT INTO branch(name,status,mechanism,end_condition,updated_by,updated)
                           VALUES (?,?,?,?,?,?)
                           ON CONFLICT(name) DO UPDATE SET
                             status=COALESCE(excluded.status,branch.status),
                             mechanism=COALESCE(excluded.mechanism,branch.mechanism),
                             end_condition=COALESCE(excluded.end_condition,branch.end_condition),
                             updated_by=excluded.updated_by, updated=excluded.updated""",
                        (a.name, a.status or "open", a.mechanism, a.end_condition,
                         resolve_self() or "unknown", t))
            con.commit()
        print(f"branch {a.name} set")
    elif a.bcmd == "map":
        rows = con.execute("SELECT * FROM branch ORDER BY status, name").fetchall()
        print("EXPLORATION MAP (branches × status):")
        for r in rows:
            counts = " ".join(f"{k}:{v}" for k, v in _status_counts(con, r["name"]).items())
            print(f"  [{r['status']:<6}] {r['name']:<26} {(r['mechanism'] or '')[:50]}  {counts}")
            if r["end_condition"]: print(f"           end: {r['end_condition']}")
        unc = _uncurated_branches(con)
        for name, cs in unc:
            counts = " ".join(f"{k}:{v}" for k, v in cs.items())
            print(f"  [uncur.] {name:<26} (referenced by claims, not yet curated)  {counts}")
        if not rows and not unc: print("  (no branches)")

# ---------- AIMS TREE (prescriptive program; claims with claim.aim set = evidence underneath) ----------
VERDICTS = ("proposed", "active", "claimed", "likely", "falsified", "deferred", "retired")
AIM_OPS  = ("add-node", "set-verdict", "retitle", "note", "retire-node")

def _aim_key(aid):            # natural sort for dotted ids: "1.1.2" -> (1,1,2)
    try: return tuple(int(x) for x in aid.split("."))
    except ValueError: return (10**9,) + tuple(ord(c) for c in aid)
def _aim_parent(aid): return aid.rsplit(".", 1)[0] if "." in aid else None
def _aim_get(con, aid):
    r = con.execute("SELECT * FROM aim WHERE id=?", (aid,)).fetchone()
    if not r: die(f"no aim '{aid}' — see `lab aim tree`")
    return r
def _aim_evidence(con, aid):
    rows = con.execute("SELECT * FROM claim WHERE aim=? ORDER BY created", (aid,)).fetchall()
    return rows, sum(1 for r in rows if r["status"] in DEAD)
def _record_verdict(con, aid, old, new, why, who, t):
    con.execute("INSERT INTO aim_history(aim_id,old_verdict,new_verdict,why,by_who,at) VALUES (?,?,?,?,?,?)",
                (aid, old, new, why, who, t))

# verdicts that carry their WHY into the compact/injected render (conclusions worth the tokens);
# proposed/active/retired don't (proposed = not decided, active = in progress, retired = dropped).
WHY_VERDICTS = ("claimed", "likely", "falsified", "deferred")

def _trunc(s, n=160):   # truncate at a WORD boundary with an ellipsis — never mid-word
    s = s.strip()
    if len(s) <= n: return s
    cut = s[:n].rsplit(" ", 1)[0].rstrip(" ,;·-")
    return (cut or s[:n]) + "…"

def cmd_aim_tree(a):
    con = connect()
    rows = sorted(con.execute("SELECT * FROM aim").fetchall(), key=lambda r: _aim_key(r["id"]))
    if not rows: print("(no aims — seed with `lab aim seed`)"); return
    for r in rows:
        line = f"{'  '*r['id'].count('.')}{r['id']}  {r['title'] or ''}  [{r['verdict']}]"
        if not a.compact:
            ev, dead = _aim_evidence(con, r["id"])
            if ev: line += f"  {len(ev)} ev" + (f" ({dead} retracted)" if dead else "")
        if getattr(a, "why", False) and r["verdict"] in WHY_VERDICTS and r["verdict_why"]:
            line += f" — {_trunc(r['verdict_why'], 160)}"   # whys only on concluded verdicts; word-boundary truncated
        print(line)

def cmd_aim_show(a):
    con = connect(); r = _aim_get(con, a.id)
    print(f"AIM {r['id']}  [{r['verdict']}]  {r['title'] or ''}")
    if r["note"]: print(f"  note: {r['note']}")
    if r["verdict_why"]: print(f"  why:  {r['verdict_why']}  (by {r['updated_by'] or '?'} {r['updated'] or ''})")
    hist = con.execute("SELECT * FROM aim_history WHERE aim_id=? ORDER BY hid DESC LIMIT 5", (a.id,)).fetchall()
    if hist:
        print("  history:")
        for h in reversed(hist):
            print(f"    {(h['at'] or '?')[:10]}  {h['old_verdict'] or '-'} -> {h['new_verdict']}  ({h['why'] or ''}) by {h['by_who'] or '?'}")
    kids = sorted([x for x in con.execute("SELECT id,title,verdict FROM aim").fetchall()
                   if _aim_parent(x["id"]) == a.id], key=lambda x: _aim_key(x["id"]))
    if kids:
        print("  children:")
        for k in kids: print(f"    {k['id']}  {k['title'] or ''}  [{k['verdict']}]")
    ev, dead = _aim_evidence(con, a.id)
    print(f"  evidence ({len(ev)} claim(s)" + (f", {dead} not current" if dead else "") + "):")
    for c in ev: print("  " + fmt_hit(con, c).replace("\n", "\n  "))
    if not ev: print(f"    (none logged — `lab aim log {a.id} --result … --setting …`)")
    pend = con.execute("SELECT * FROM aim_pending WHERE aim_id=? AND status='pending' ORDER BY pid", (a.id,)).fetchall()
    if pend:
        print("  PENDING edits (awaiting Zac):")
        for p in pend: print(f"    #{p['pid']} {p['op']}: {p['payload'] or ''} — {p['rationale'] or ''} (by {p['proposed_by']})")

def cmd_aim_log(a):
    if not a.setting: die("--setting is REQUIRED (the conditions that produced this result)")
    status = a.status or "open"
    if status not in STATUSES: die(f"status must be one of {STATUSES}")
    card, waiver = None, None
    if status == "holds":                      # 'no card, no holds' — aim log always creates a result
        card, waiver = _card_gate(a)
    with WriteLock():
        con = connect(); _aim_get(con, a.id)
        cid = mkid(con, a.result, a.setting); t = now()
        con.execute("""INSERT INTO claim(id,statement,kind,status,setting,evidence,source,author,date,aim,branch,card,card_waiver,created,updated)
                       VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                    (cid, a.result, "result", status, a.setting, a.evidence, a.source,
                     resolve_self() or "unknown", a.date, a.id, getattr(a, "branch", None), card, waiver, t, t))
        con.commit()
    print(f"logged claim {cid} onto aim {a.id}  [{status}]" +
          (f"  (card: {os.path.basename(card)})" if card else f"  (no-card: {waiver})" if waiver else ""))

def cmd_aim_link(a):    # attach an EXISTING claim to an aim (the manager's claim->aim linking pass)
    with WriteLock():
        con = connect(); _aim_get(con, a.aim_id); get(con, a.claim_id)
        con.execute("UPDATE claim SET aim=?, updated=? WHERE id=?", (a.aim_id, now(), a.claim_id))
        con.commit()
    print(f"linked claim {a.claim_id} -> aim {a.aim_id}")

def _apply_op(con, op, aim_id, payload, who, t):
    p = payload or {}
    if op == "add-node":
        con.execute("INSERT OR REPLACE INTO aim(id,title,note,verdict,updated_by,updated) VALUES (?,?,?,?,?,?)",
                    (aim_id, p.get("title"), p.get("note"), p.get("verdict", "proposed"), who, t))
    elif op == "retitle":
        con.execute("UPDATE aim SET title=?, updated_by=?, updated=? WHERE id=?", (p.get("title"), who, t, aim_id))
    elif op == "note":
        con.execute("UPDATE aim SET note=?, updated_by=?, updated=? WHERE id=?", (p.get("note"), who, t, aim_id))
    elif op in ("set-verdict", "retire-node"):
        new = "retired" if op == "retire-node" else p.get("verdict")
        old = con.execute("SELECT verdict FROM aim WHERE id=?", (aim_id,)).fetchone()
        con.execute("UPDATE aim SET verdict=?, verdict_why=?, updated_by=?, updated=? WHERE id=?",
                    (new, p.get("why"), who, t, aim_id))
        _record_verdict(con, aim_id, old["verdict"] if old else None, new, p.get("why"), who, t)

def cmd_aim_propose(a):
    if a.op not in AIM_OPS: die(f"op must be one of {AIM_OPS}")
    if a.verdict and a.verdict not in VERDICTS: die(f"verdict must be one of {VERDICTS}")
    payload = {k: v for k, v in (("title", a.title), ("verdict", a.verdict), ("why", a.why), ("note", a.note)) if v is not None}
    with WriteLock():
        con = connect()
        con.execute("INSERT INTO aim_pending(op,aim_id,payload,proposed_by,proposed_at,rationale,status) "
                    "VALUES (?,?,?,?,?,?, 'pending')",
                    (a.op, a.id, json.dumps(payload), resolve_self() or "unknown", now(), a.rationale))
        pid = con.execute("SELECT last_insert_rowid()").fetchone()[0]; con.commit()
    print(f"proposed #{pid}: {a.op} on {a.id} — awaiting Zac (`lab aim approve {pid} --by zac`)")

def cmd_aim_pending(a):
    con = connect()
    rows = con.execute("SELECT * FROM aim_pending WHERE status='pending' ORDER BY pid").fetchall()
    if not rows: print("(no pending tree edits)"); return
    print(f"PENDING tree edits ({len(rows)}) — Zac approves/rejects:")
    for p in rows:
        print(f"  #{p['pid']}  {p['op']} on {p['aim_id'] or '(new)'}  {p['payload'] or ''}")
        print(f"       {p['rationale'] or ''}  (by {p['proposed_by']} {(p['proposed_at'] or '')[:10]})")

def cmd_aim_approve(a):
    with WriteLock():
        con = connect()
        p = con.execute("SELECT * FROM aim_pending WHERE pid=?", (a.pid,)).fetchone()
        if not p: die(f"no pending #{a.pid}")
        if p["status"] != "pending": die(f"#{a.pid} already {p['status']}")
        t = now()
        _apply_op(con, p["op"], p["aim_id"], json.loads(p["payload"] or "{}"), a.by, t)
        con.execute("UPDATE aim_pending SET status='approved', decided_by=?, decided_at=?, decision_note=? WHERE pid=?",
                    (a.by, t, a.note, a.pid))
        con.commit()
    print(f"approved #{a.pid} ({p['op']} on {p['aim_id']}) — applied")

def cmd_aim_reject(a):
    with WriteLock():
        con = connect()
        p = con.execute("SELECT status FROM aim_pending WHERE pid=?", (a.pid,)).fetchone()
        if not p: die(f"no pending #{a.pid}")
        if p["status"] != "pending": die(f"#{a.pid} already {p['status']}")
        con.execute("UPDATE aim_pending SET status='rejected', decided_by=?, decided_at=?, decision_note=? WHERE pid=?",
                    (a.by, now(), a.note, a.pid)); con.commit()
    print(f"rejected #{a.pid} (kept for the record)")

def cmd_aim_set(a):
    # live fast path: Zac decided in-session -> apply now, record approver. Refuses without --approved-by.
    if not a.approved_by:
        die("`lab aim set` refuses without --approved-by (Zac's live decision). To queue for approval:\n"
            f"  lab aim propose set-verdict {a.id} --verdict {a.verdict or '<v>'} --why '…' --rationale '…'")
    if not a.verdict or a.verdict not in VERDICTS: die(f"--verdict must be one of {VERDICTS}")
    with WriteLock():
        con = connect(); r = _aim_get(con, a.id); t = now(); me = resolve_self() or "?"
        con.execute("UPDATE aim SET verdict=?, verdict_why=?, updated_by=?, updated=? WHERE id=?",
                    (a.verdict, a.why, f"{me} (approved-by {a.approved_by})", t, a.id))
        _record_verdict(con, a.id, r["verdict"], a.verdict, a.why, f"{me}/approved:{a.approved_by}", t)
        con.commit()
    print(f"aim {a.id}: {r['verdict']} -> {a.verdict}  (approved-by {a.approved_by})")

def _parse_aim_draft(path):
    aims, cur = [], None
    for line in open(path, encoding="utf-8", errors="replace"):
        m = re.match(r"^#{1,6}\s*Aim\s+([\d.]+)\s*:\s*(.+?)\s*$", line)
        if m: cur = {"id": m.group(1), "title": m.group(2), "note": None}; aims.append(cur); continue
        n = re.match(r"^\s*-\s*Core[^:]*:\s*(.+?)\s*$", line)
        if n and cur: cur["note"] = ((cur["note"] + " | ") if cur["note"] else "") + n.group(1)
    return aims

def cmd_aim_seed(a):
    path = a.file or os.path.join(LAB, "decisions", "projectmindtree-draft-zac.txt")
    if not os.path.isfile(path): die(f"seed draft not found: {path}")
    aims = _parse_aim_draft(path)
    if not aims: die(f"no `# Aim N: …` headings parsed from {path}")
    con = connect()
    have = set(r["id"] for r in con.execute("SELECT id FROM aim").fetchall())
    new = [x for x in aims if x["id"] not in have]
    print(f"SEED {'COMMIT' if a.commit else 'PREVIEW'} — {len(aims)} aims parsed, {len(new)} new, {len(aims)-len(new)} present")
    newids = set(z["id"] for z in new)
    for x in sorted(aims, key=lambda z: _aim_key(z["id"])):
        print(f"  [{'NEW ' if x['id'] in newids else 'have'}] {x['id']:<10} {x['title'][:58]}" +
              (f"   · {x['note'][:36]}" if x["note"] else ""))
    if not a.commit:
        print("\nAll seed as verdict='proposed' (manager asserts real verdicts after). Re-run with --commit."); return
    with WriteLock():
        con = connect(); t = now(); who = resolve_self() or "unknown"
        for x in new:
            con.execute("INSERT INTO aim(id,title,note,verdict,updated_by,updated) VALUES (?,?,?,'proposed',?,?)",
                        (x["id"], x["title"], x["note"], who, t))
        con.commit()
    print(f"committed {len(new)} aims (proposed).")

def _render_data(con):
    aims = sorted(con.execute("SELECT * FROM aim").fetchall(), key=lambda r: _aim_key(r["id"]))
    pend_all = con.execute("SELECT * FROM aim_pending WHERE status='pending' ORDER BY pid").fetchall()
    out = []
    for a in aims:
        ev_rows, _ = _aim_evidence(con, a["id"])
        ev = [{"statement": c["statement"], "status": c["status"], "setting": c["setting"] or "",
               "source": c["source"] or "", "date": c["date"] or "", "author": c["author"] or "",
               "reason": c["status_reason"] or "", "successor": successor(con, c["id"]) or "",
               "dead": c["status"] in DEAD} for c in ev_rows]
        hist = [{"old": h["old_verdict"] or "", "new": h["new_verdict"] or "", "why": h["why"] or "",
                 "by": h["by_who"] or "", "at": (h["at"] or "")[:10]} for h in
                con.execute("SELECT * FROM aim_history WHERE aim_id=? ORDER BY hid", (a["id"],)).fetchall()]
        pend = [{"pid": p["pid"], "op": p["op"], "payload": p["payload"] or "", "rationale": p["rationale"] or "",
                 "by": p["proposed_by"] or ""} for p in pend_all if p["aim_id"] == a["id"]]
        out.append({"id": a["id"], "title": a["title"] or "", "note": a["note"] or "",
                    "verdict": a["verdict"], "why": a["verdict_why"] or "",
                    "updated_by": a["updated_by"] or "", "updated": (a["updated"] or "")[:10],
                    "evidence": ev, "history": hist, "pending": pend})
    return out, len(pend_all)

MAX_CARD_BYTES = 96 * 1024     # per-card embed cap; cards are small markdown, this is a runaway guard

def export_data(con):
    """Complete mechanical snapshot of the knowledge map: aims + ALL claims (linked and orphan) +
    edges + branches + pending + history + embedded card text. Reads only; stat/read of card FILES
    is per-pointer (never walks a tree)."""
    aims = sorted(con.execute("SELECT * FROM aim").fetchall(), key=lambda r: _aim_key(r["id"]))
    aim_ids = {a["id"] for a in aims}
    claims = con.execute("SELECT * FROM claim").fetchall()

    cards, seen = {}, {}
    for c in claims:
        p = c["card"]
        if not p: continue
        cards.setdefault(p, {"path": p, "exists": False, "text": "", "claims": [], "error": ""})
        cards[p]["claims"].append(c["id"])
        if p in seen: continue
        seen[p] = True
        try:
            if os.path.isfile(p):                       # stat, then read one known file — no walking
                cards[p]["exists"] = True
                if os.path.getsize(p) > MAX_CARD_BYTES:
                    cards[p]["text"] = open(p, encoding="utf-8", errors="replace").read(MAX_CARD_BYTES)
                    cards[p]["error"] = f"truncated at {MAX_CARD_BYTES} bytes"
                else:
                    cards[p]["text"] = open(p, encoding="utf-8", errors="replace").read()
        except OSError as e:
            cards[p]["error"] = f"unreadable: {e}"

    def claim_row(c):
        d = {k: (c[k] if c[k] is not None else "") for k in c.keys()}
        d["dead"] = c["status"] in DEAD
        d["successor"] = successor(con, c["id"]) or ""
        d["orphan"] = not (c["aim"] and c["aim"] in aim_ids)
        return d

    kids = {}
    for a in aims:
        p = _aim_parent(a["id"])
        if p: kids.setdefault(p, []).append(a["id"])

    return {
        "generated": now(),
        "aims": [{"id": a["id"], "title": a["title"] or "", "note": a["note"] or "",
                  "verdict": a["verdict"] or "proposed", "why": a["verdict_why"] or "",
                  "updated_by": a["updated_by"] or "", "updated": (a["updated"] or "")[:10],
                  "parent": _aim_parent(a["id"]), "depth": a["id"].count(".") ,
                  "children": kids.get(a["id"], [])} for a in aims],
        "claims": [claim_row(c) for c in claims],
        "edges": [dict(src=e["src"], rel=e["rel"], dst=e["dst"], note=e["note"] or "")
                  for e in con.execute("SELECT * FROM edge").fetchall()],
        "branches": [dict(name=b["name"], status=b["status"] or "", mechanism=b["mechanism"] or "",
                          end_condition=b["end_condition"] or "", updated=(b["updated"] or "")[:10])
                     for b in con.execute("SELECT * FROM branch ORDER BY name").fetchall()],
        "pending": [dict(pid=p["pid"], aim_id=p["aim_id"] or "", op=p["op"], payload=p["payload"] or "",
                         rationale=p["rationale"] or "", by=p["proposed_by"] or "",
                         at=(p["proposed_at"] or "")[:10])
                    for p in con.execute("SELECT * FROM aim_pending WHERE status='pending' ORDER BY pid")],
        "history": [dict(aim_id=h["aim_id"], old=h["old_verdict"] or "", new=h["new_verdict"] or "",
                         why=h["why"] or "", by=h["by_who"] or "", at=(h["at"] or "")[:10])
                    for h in con.execute("SELECT * FROM aim_history ORDER BY hid")],
        "cards": list(cards.values()),
        "verdicts": list(VERDICTS), "statuses": list(STATUSES), "kinds": list(KINDS), "dead": list(DEAD),
    }

APP_TEMPLATE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "lab-know-app.html")

def cmd_app(a):
    """Build the self-contained knowledge-map app: template + inlined export. No network, no CDN,
    no build step — one HTML file that opens anywhere (and is CSP-safe as a claude.ai artifact)."""
    if not os.path.isfile(APP_TEMPLATE): die(f"app template missing: {APP_TEMPLATE}")
    data = export_data(connect())
    blob = json.dumps(data, ensure_ascii=False).replace("</", "<\\/")   # safe to inline in <script>
    html = open(APP_TEMPLATE, encoding="utf-8").read().replace("__DATA__", blob)
    if getattr(a, "fragment", False):
        html = _fragment(html)                      # claude.ai artifacts must be page-content-only
        out = a.out or os.path.join(LAB, "KNOWLEDGE_MAP.artifact.html")
    else:
        out = a.out or os.path.join(LAB, "KNOWLEDGE_MAP.html")
    with open(out, "w", encoding="utf-8") as f: f.write(html)
    print(f"lab know app: wrote {out}  ({len(data['aims'])} aims, {len(data['claims'])} claims, "
          f"{len(data['cards'])} cards, {len(html)//1024} KB)")

def cmd_export(a):
    data = export_data(connect())
    blob = json.dumps(data, ensure_ascii=False, indent=None if a.compact else 2)
    if a.out:
        with open(a.out, "w", encoding="utf-8") as f: f.write(blob)
        n = data["counts"] if "counts" in data else ""
        print(f"lab know export: wrote {a.out} "
              f"({len(data['aims'])} aims, {len(data['claims'])} claims, {len(data['cards'])} cards)")
    else:
        sys.stdout.write(blob + "\n")

