#!/usr/bin/env bash
# lab-scanwatch — cron watchdog for FORBIDDEN broad NFS scans (compute-etiquette rule #1: the
# 25.9h find that storms the RPC table and degrades the node for everyone). A SCOPED scan finishes
# fast; only broad ones run long enough to saturate NFS — so this keys on the HARM (long-running),
# not the command shape. Flags find/du/grep -r/rg/locate/updatedb whose argv target OR resolved
# cwd sits on a big NFS mount (isilon/home/scr1/cm-shared) and has run > LAB_SCAN_LONG_SEC.
#
#   live-owner scan    -> WARN the owning agent (attributed via CLAUDE_JOB_DIR from the process, so it
#                         works even when the scan detached from its tool-call shell; owner-liveness
#                         from the agent's lab-watch lock — a detached scan is owned, not orphaned)
#   no live owner      -> ALERT the technician to VERIFY then kill by hand (per Zac: no auto-kill;
#                         orphaned session, or a deliberate nohup/setsid, so a human confirms first)
#
# Cheap when nothing's scanning (one ps). Rate-limited per pid. Everything logged. DRY mode prints.
# Env (lab.env): LAB_SCAN_LONG_SEC (default 90), LAB_SCAN_COOLDOWN_MIN (30).
# Test: LAB_SCANWATCH_DRYRUN=1 LAB_SCAN_LONG_SEC=5 lab-scanwatch  (prints, never sends).
set -uo pipefail
LAB="${LAB_HOME:-$HOME/lab}"
[ -f "$LAB/lab.env" ] && { set -a; . "$LAB/lab.env" 2>/dev/null || true; set +a; }
LONG_SEC="${LAB_SCAN_LONG_SEC:-90}"
DRY="${LAB_SCANWATCH_DRYRUN:-0}"
ROSTER="$LAB/.roster.tsv"
TECH="${LAB_TECHNICIAN:-technician}"
DIR="$LAB/.scanwatch"; mkdir -p "$DIR"
LOG="$DIR/scanwatch.log"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
log(){ echo "$(ts) $*" >> "$LOG"; }

# big NFS mounts where a broad scan storms the RPC table (the forbidden roots)
NFS_RE='^/(mnt/isilon|home|scr1|cm/shared)(/|$)'

# Identify the OWNER of a scan from the PROCESS itself, not its parent chain: an agent's backgrounded
# scan outlives the tool-call shell that launched it and reparents to init, so it never traces to a
# live backend even though a live agent owns it. But it still carries CLAUDE_JOB_DIR in its environ
# (cwd as fallback) -> job-id -> roster name. 'detached' is NOT 'ownerless'. (ont-fm 2026-08-14)
owner_of() {   # echoes "<job>\t<agent>" (agent may be empty if job not in roster); rc1 if no job
  local pid="$1" job
  job=$( { tr '\0' '\n' < "/proc/$pid/environ"; } 2>/dev/null | grep -oE 'CLAUDE_JOB_DIR=.*/jobs/[0-9a-f]+' | grep -oE '[0-9a-f]+$' | head -1)
  [ -n "$job" ] || job=$(readlink "/proc/$pid/cwd" 2>/dev/null | grep -oE '/jobs/[0-9a-f]+' | grep -oE '[0-9a-f]+$' | head -1)
  [ -n "$job" ] || return 1
  printf '%s\t%s' "$job" "$(awk -v j="$job" -F'\t' '$1==j{print $2}' "$ROSTER" 2>/dev/null)"
}
# Is that agent's SESSION still live? Its lab-watch lock ("$LAB/.watch/<name>.lock" = "<pid> <sid>")
# holds a live pid iff the session is up. A live owner is WARNED about its own scan (the cheap fix);
# a dead or absent owner means nobody will act on a warning -> escalate to the technician to verify+kill.
owner_live() {
  local n="$1" lk="$LAB/.watch/$1.lock" p
  [ -n "$n" ] && [ -f "$lk" ] || return 1
  read -r p _ < "$lk" 2>/dev/null
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

# clean stamps for pids that are gone (avoid unbounded growth / stale suppression on pid reuse)
for s in "$DIR"/pid-*.seen; do [ -e "$s" ] || continue; p=${s##*/pid-}; p=${p%.seen}; [ -d "/proc/$p" ] || rm -f "$s"; done

while read -r pid etimes comm; do
  [ -n "$pid" ] || continue
  [ "${etimes:-0}" -ge "$LONG_SEC" ] 2>/dev/null || continue     # long-running only
  # is it a scan tool? grep only counts when recursive (-r/-R)
  args="$( { tr '\0' ' ' < "/proc/$pid/cmdline"; } 2>/dev/null)"
  case "$comm" in
    find|du|locate|mlocate|updatedb|rg) : ;;
    grep|egrep|fgrep|ggrep) printf ' %s ' "$args" | grep -qE ' -[A-Za-z]*[rR]' || continue ;;
    *) continue ;;
  esac
  # scope = argv path tokens + resolved cwd (rg/grep -r recurse from cwd, often no mount in argv)
  cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null)"
  hit=""
  printf '%s\n' "$cwd" | grep -qE "$NFS_RE" && hit="$cwd"
  if [ -z "$hit" ]; then
    for tok in $args; do case "$tok" in /*) printf '%s\n' "$tok" | grep -qE "$NFS_RE" && { hit="$tok"; break; };; esac; done
  fi
  [ -n "$hit" ] || continue                                       # only scans hitting a big NFS mount
  # rate-limit: one alert per pid
  stamp="$DIR/pid-$pid.seen"; [ -e "$stamp" ] && continue
  mount="$(printf '%s' "$hit" | grep -oE '^/(mnt/isilon(/wang_lab)?|home|scr1|cm/shared)')"
  short_args="$(printf '%s' "$args" | cut -c1-160)"

  # attribute to the owning agent from the PROCESS (environ/cwd), then decide by OWNER LIVENESS —
  # not by whether the scan traces to a backend (an agent's detached scan never does, yet is owned).
  IFS=$'\t' read -r job agent <<<"$(owner_of "$pid")" || true
  if [ -n "$agent" ] && owner_live "$agent"; then
    # LIVE OWNER -> warn the owning agent to scope it / move it off the login node
    subj="⚠ long-running scan on $mount (${etimes}s) — scope it or move it off the login node"
    body="Automated node-health warning (technician scan-watch). Your session is running a broad scan on the shared NFS mount $mount — a scoped scan finishes in seconds, so ${etimes}s means it's walking a large tree and storming the RPC table for everyone (the compute rule that exists because a find like this once ran 25.9h).
  pid=$pid  $comm  cwd=$cwd
  $short_args
Please Ctrl-C / kill it and either scope it to the narrowest subdir with -maxdepth, or run it on a SLURM node writing to a manifest. If it's genuinely needed and bounded, ignore this."
    if [ "$DRY" = 1 ]; then echo "WARN-OWNER $agent (job ${job:-?}, live): $comm ${etimes}s on $mount cwd=$cwd"
    else
      LAB_FROM="scanwatch" "$SELF/lab" send --force "$agent" "$subj" "$body" >>"$LOG" 2>&1
      touch "$stamp"; log "WARNED $agent (job $job, live): long scan pid=$pid $comm ${etimes}s on $mount cwd=$cwd args=[$short_args]"
    fi
  else
    # NO LIVE OWNER (session gone, or no CLAUDE_JOB_DIR at all) -> alert technician to VERIFY then kill
    # by hand (no auto-kill; the owner can't act on a warning, so a human confirms orphaned vs detached).
    ppid=$(awk '/^PPid:/{print $2; exit}' "/proc/$pid/status" 2>/dev/null)
    sid=$(awk '{print $6}' "/proc/$pid/stat" 2>/dev/null)
    start="$(ps -o lstart= -p "$pid" 2>/dev/null | sed 's/^ *//')"
    owner_note="${agent:+owner=$agent (job $job) but its session is NOT live — }"
    subj="🛑 VERIFY+KILL? scan on $mount running ${etimes}s with no live owner"
    body="Automated node-health alert (scan-watch). A long-running scan on the shared NFS mount $mount has no live owning session — ${owner_note}so it's orphaned (session exited: the class that caused the 25.9h incident) OR a deliberate detached job (nohup/setsid). Per policy this does NOT auto-kill — verify which, then kill by hand if orphaned:
  pid=$pid  $comm  ${etimes}s  ppid=$ppid  sid=$sid  started=$start
  cwd=$cwd
  $short_args
Verify: is sid $sid a dead session (nothing else alive in it) on a forbidden root? If orphaned -> kill $pid (record argv/cwd/runtime/mount to BOARD${agent:+ + tell $agent}). If it's a deliberate detached job someone wanted -> leave it."
    if [ "$DRY" = 1 ]; then echo "ALERT-TECH no-live-owner: pid=$pid $comm ${etimes}s on $mount ${agent:+owner=$agent(dead) }ppid=$ppid sid=$sid cwd=$cwd"
    else
      LAB_FROM="scanwatch" "$SELF/lab" send --force "$TECH" "$subj" "$body" >>"$LOG" 2>&1
      touch "$stamp"; log "ALERT-TECH no-live-owner scan pid=$pid $comm ${etimes}s on $mount ${agent:+owner=$agent(dead) }ppid=$ppid sid=$sid cwd=$cwd args=[$short_args]"
    fi
  fi
done < <(ps -eo pid=,etimes=,comm= 2>/dev/null)
