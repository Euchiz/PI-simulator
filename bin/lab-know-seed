#!/usr/bin/env python3
"""lab-know-seed — one-time (and re-runnable) SEED parser for the knowledge ledger.

Parses the corpus the lab already writes — meeting posts + decisions/ — into candidate claims and
branches, and either PREVIEWS them (default: prints, writes NOTHING) or --commit inserts via the
lab-know engine. Built to the knowledge-map spec §9 and the tolerance rules the manager locked:

  * auto-extracted claims land as status=open (unconfirmed) and NEVER auto-assert `holds`;
  * the ONE exception is a retraction table whose row says a claim is DEAD/RETRACTED/WITHDRAWN/… —
    recording that as status=retracted is faithful AND the safe direction (it hides it, never
    surfaces it as current), which is the whole point of parsing retraction tables;
  * `setting` is never a table column, so it is resolved from the nearest preceding prose/heading,
    falling back to "session <s>, <date>"; a row whose setting can't resolve is still emitted (open,
    flagged) — never dropped, never guessed;
  * shapes that are ambiguous or are NOT claims (issues.md job/config tables, inline prose
    retractions) are SKIPPED and reported in a coverage section, not silently ingested.

Preview is safe to run anytime (read-only). Review the preview, THEN --commit. Dedup on
(statement, source) so re-runs don't double-insert.

Usage:
  lab-know-seed [--posts] [--decisions] [--limit N]        # preview (default: both sources)
  lab-know-seed --commit                                   # actually insert (after review)
"""
import os, re, sys, glob, subprocess, argparse, datetime

HOME = os.path.expanduser("~")
LAB  = os.environ.get("LAB_HOME", os.path.join(HOME, "lab"))
KNOW = os.path.join(os.path.dirname(os.path.abspath(__file__)), "lab-know")
BOARD_DAYS = int(os.environ.get("LAB_BOARD_DAYS", "14"))   # board notes older than this are skipped
                                                           # (history is already covered by the meeting-post seed)

# keyword -> a CLEAR retraction (auto status=retracted); anything else stays open (never auto-holds)
RETRACT_KW = ("dead", "retracted", "retract", "withdrawn", "deleted", "refuted",
              "rejected", "killed", "false", "no-go", "wrong", "abandoned")
# ambiguous verdicts we keep the raw text for but do NOT force into the enum
AMBIG_KW   = ("scoped", "closed", "narrow", "parked", "unmeasurable", "overstated", "corrected")
NOT_CLAIM_SESSIONS = ("issues",)          # issues.md posts are task/job trackers, not claims
RESULT_METRIC_RE = re.compile(r"spearman|mcc|auroc|auc|r²|r2|accuracy|precision|recall|ece|f1", re.I)
NUM_RE = re.compile(r"[+\-−]\s?\d*\.\d+")   # a signed decimal effect size

def clean_md(s):
    s = re.sub(r"~~(.*?)~~", r"\1", s)              # de-strikethrough
    s = re.sub(r"\*\*(.*?)\*\*", r"\1", s)          # de-bold
    s = re.sub(r"\*(.*?)\*", r"\1", s)              # de-italic
    s = re.sub(r"`([^`]*)`", r"\1", s)              # de-code
    s = re.sub(r"[✅❌🔴⚠️☠️🔒⏸️🔄⏳🟢🟡➡️→]", " ", s)
    return re.sub(r"\s+", " ", s).strip()

def is_fragment(s):
    # parser debris, not a claim (wet-lab 2026-08-19): a mid-sentence selection-criteria parenthetical
    # captured with a trailing ARROW. Keep this NARROW — an unbalanced-parens/trailing-dash test
    # false-positives on real headlines truncated mid-paren or mid-word, so only the two genuine
    # fragment signals: a trailing arrow, or a bare short pure-parenthetical (no verb).
    s = (s or "").strip()
    if not s: return True
    if re.search(r"(->|→)\s*$", s): return True                     # trailing arrow = a mid-sentence rule
    if s.startswith("(") and s.endswith(")") and len(s) < 50: return True   # bare short parenthetical
    return False

def status_from(cell):
    """(status, raw_verdict_or_None) from a status cell / verdict text."""
    low = clean_md(cell).lower()
    if not low: return "open", None
    for kw in RETRACT_KW:
        if re.search(rf"\b{re.escape(kw)}\b", low): return "retracted", low
    for kw in AMBIG_KW:
        if re.search(rf"\b{re.escape(kw)}\b", low): return "open", low
    if re.search(r"\bholds?\b|\bsurviv|\breal\b|\bvalidated\b", low): return "open", low  # NEVER auto-holds
    return "open", low

def frontmatter(text):
    m = re.match(r"^---\s*\n(.*?)\n---\s*\n", text, re.S)
    fm = {}
    if m:
        for line in m.group(1).splitlines():
            if ":" in line:
                k, v = line.split(":", 1); fm[k.strip().lower()] = v.strip()
    return fm

def md_tables(text):
    """Yield (header[list], rows[list of lists], context_line) for each pipe-table in the text."""
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        sep = i + 1 < len(lines) and bool(re.match(r"^\s*\|?[\s:|>-]*-[\s:|>-]*\|", lines[i + 1]))
        if "|" in lines[i] and sep:
            header = [c.strip() for c in lines[i].strip().strip("|").split("|")]
            rows, j = [], i + 2
            while j < len(lines) and "|" in lines[j] and lines[j].strip():
                rows.append([c.strip() for c in lines[j].strip().strip("|").split("|")])
                j += 1
            ctx, k = "", i - 1
            while k >= 0:
                if lines[k].strip():
                    ctx = clean_md(re.sub(r"^#+\s*", "", lines[k].strip())); break
                k -= 1
            yield header, rows, ctx
            i = j
        else:
            i += 1

def col_index(header, *names):
    for idx, h in enumerate(header):
        hl = clean_md(h).lower()
        if any(n in hl for n in names): return idx
    return -1

# ---------------- extractors ----------------
def extract_from_post(path, skips):
    text = open(path, encoding="utf-8", errors="replace").read()
    fm = frontmatter(text)
    session = fm.get("session") or re.sub(r"\.md$", "", os.path.basename(path))
    date = fm.get("meeting") or fm.get("posted", "")[:10]
    src = f"meeting:{date}#{session}"
    if session in NOT_CLAIM_SESSIONS:
        skips.append(f"{path}: session '{session}' is a task/job tracker — skipped (not claims)")
        return [], []
    claims = []
    def setting_of(ctx):
        return ctx if ctx and len(ctx) > 4 else f"session {session}, {date}"
    for header, rows, ctx in md_tables(text):
        ci = col_index(header, "claim", "instrument", "finding")
        si = col_index(header, "status")
        wi = col_index(header, "why", "reason", "killed", "impossibility", "produced", "could not")
        killed_col = col_index(header, "killed")          # a 'killed by' column => the table IS retractions
        # retraction context: the heading/prose above says these claims were retracted/killed/died/withdrawn.
        # "died"/"withdrawn" (ont-fm's variant) must count, not just the literal word "retract".
        ctx_retract = bool(re.search(r"retract|\bkill|\bdied\b|withdrawn|refuted|casualt|\bdead\b", ctx.lower()))
        is_result_tbl = any(RESULT_METRIC_RE.search(clean_md(h)) for h in header)
        if ci >= 0 and (si >= 0 or killed_col >= 0 or ctx_retract):
            # retraction / status table family: claim|status|why (R1), claim|status (R2, mixed rows),
            # claim|killed-by (R3), or any claim table under a retraction heading.
            for r in rows:
                if ci >= len(r): continue
                stmt = clean_md(r[ci])
                if not stmt: continue
                if 0 <= si < len(r):
                    st, raw = status_from(r[si])          # per-row status (handles mixed holds/retracted audits)
                else:
                    st, raw = "retracted", None            # no status col but killed-by/retract context => all retracted
                why = clean_md(r[wi]) if 0 <= wi < len(r) else None
                claims.append(dict(statement=stmt[:200], kind="result", status=st,
                                   setting=setting_of(ctx), evidence=None,
                                   status_reason=(why or raw), source=src, author=session, date=date))
        elif is_result_tbl:
            # method x metric result table -> one open result claim per row, statement built by
            # pairing each metric HEADER with its numeric cell ("poreior_caller — Spearman +0.380; MCC +0.482")
            for r in rows:
                if not r or not clean_md(r[0]): continue
                label = clean_md(r[0])
                pairs = []
                for hi in range(1, min(len(header), len(r))):
                    val = clean_md(r[hi])
                    if NUM_RE.search(val): pairs.append(f"{clean_md(header[hi])[:22]} {val}")
                if not pairs: continue
                stmt = f"{label} — " + "; ".join(pairs[:4])
                claims.append(dict(statement=stmt[:200], kind="result", status="open",
                                   setting=setting_of(ctx), evidence="; ".join(pairs),
                                   status_reason=None, source=src, author=session, date=date))
        else:
            if len(rows) >= 2:
                skips.append(f"{path}: table under '{ctx[:40]}' not a claim/result shape — skipped")
    # headline result lines: bold text with a signed effect + a CI/metric. Filter fragments:
    # must not contain a table pipe, and must start like a sentence/result (not mid-clause).
    for m in re.finditer(r"\*\*([^*]{12,240})\*\*", text):
        seg = m.group(1).strip()
        if "|" in seg: continue
        if not re.match(r"^[\"'(]*[A-Z0-9+\-−]", seg): continue
        if NUM_RE.search(seg) and re.search(r"CI\s*\[|AUROC|Spearman|MCC|R²|p[≈=]|\bn\s?=", seg):
            claims.append(dict(statement=clean_md(seg)[:200], kind="result", status="open",
                               setting=f"session {session}, {date}", evidence=None,
                               status_reason=None, source=src, author=session, date=date))
    return claims, []

def extract_branches(path, skips):
    """Parse a direction-tree style file (legend + ## BRANCH + ### node <status-emoji>) -> branches."""
    text = open(path, encoding="utf-8", errors="replace").read()
    if "BRANCH" not in text and "Legend" not in text:
        return []
    branches = []
    emoji_status = [("☠️", "closed"), ("DEAD", "closed"), ("RETRACT", "closed"),
                    ("🔒", "closed"), ("CLOSED", "closed"), ("⏸️", "parked"), ("PARKED", "parked"),
                    ("✅", "open"), ("LIVE", "open")]
    for m in re.finditer(r"^##+\s*(BRANCH\s+\w+\s*[—\-:]\s*)?(.+)$", text, re.M):
        head = m.group(2).strip()
        if not head or head.lower().startswith(("what", "the ", "legend")): continue
        st = "open"
        for tok, s in emoji_status:
            if tok in head: st = s; break
        name = clean_md(re.sub(r"[—\-:].*$", "", head)).strip()[:40] or clean_md(head)[:40]
        if len(name) < 3: continue
        branches.append(dict(name=name.lower().replace(" ", "-"), status=st,
                             mechanism=clean_md(head)[:120], source=os.path.basename(path)))
    return branches

# board notes demonstrably carry results (poreior's 0.675, morpheus's +0.0425 went ONLY to the board).
# result-signal heuristic: a decimal metric or a result keyword. Notes with neither (announcements/plans)
# are skipped + reported; the rest land status=open — the review queue is the filter (manager 2026-08-19).
BOARD_RESULT_RE = re.compile(
    r"\d\.\d\d|[+\-−]\s?\d*\.\d+|reproduc|negative|beats|earns|purity|auroc|spearman|\bmcc\b|slope|"
    r"separat|\bnull\b|refut|retract|validated|significan|p[≈=]|falsif|correction", re.I)

def extract_board(path, skips, days=BOARD_DAYS):
    if not os.path.isfile(path): return []
    text = open(path, encoding="utf-8", errors="replace").read()
    cutoff = (datetime.date.today() - datetime.timedelta(days=days)).isoformat() if days > 0 else "0000"
    claims = []; old = 0
    # each note: "- [ ] YYYY-MM-DD — <body…> _(from <session>)_"; body spans (non-greedy) to the closer
    for m in re.finditer(r"^- \[[ xX]\]\s*(\d{4}-\d{2}-\d{2})\s*[—\-]\s*(.*?)_\(from\s*([^)]+)\)_",
                         text, re.S | re.M):
        date, body, sess = m.group(1), m.group(2).strip(), m.group(3).strip()
        if date < cutoff: old += 1; continue                      # recency cutoff — history is covered by the post seed
        headline = clean_md(body.split("\n", 1)[0])
        if not headline: continue
        if not BOARD_RESULT_RE.search(body):
            skips.append(f"BOARD.md {date} ({sess}): '{headline[:40]}' — no result signal, skipped (announcement/plan)")
            continue
        claims.append(dict(statement=headline[:200], kind="result", status="open",
                           setting=f"board note, {sess}, {date}", evidence=None, status_reason=None,
                           source=f"board:{date}#{sess}", author=sess, date=date))
    if old: skips.append(f"BOARD.md: {old} notes older than {days}d skipped (recency cutoff; history is in the post seed)")
    return claims

# ---------------- driver ----------------
def existing_keys():
    """(statement, source) pairs already in the DB, to dedup re-runs."""
    keys = set()
    try:
        import sqlite3
        con = sqlite3.connect(os.path.join(LAB, "knowledge.db"))
        for s, src in con.execute("SELECT statement, source FROM claim"):
            keys.add((s, src or ""))
    except Exception:
        pass
    return keys

def commit_claim(c):
    args = [KNOW, "add", "--statement", c["statement"], "--kind", c["kind"],
            "--status", c["status"], "--setting", c["setting"], "--source", c["source"],
            "--author", c["author"]]
    if c.get("date"): args += ["--date", c["date"]]
    if c.get("evidence"): args += ["--evidence", c["evidence"]]
    if c.get("status_reason"): args += ["--status-reason", c["status_reason"]]
    if c.get("branch"): args += ["--branch", c["branch"]]
    r = subprocess.run(args, capture_output=True, text=True, env={**os.environ, "LAB_HOME": LAB})
    return r.returncode == 0, (r.stdout + r.stderr).strip()

def commit_branch(b):
    args = [KNOW, "branch", "set", b["name"], "--status", b["status"], "--mechanism", b["mechanism"]]
    r = subprocess.run(args, capture_output=True, text=True, env={**os.environ, "LAB_HOME": LAB})
    return r.returncode == 0, (r.stdout + r.stderr).strip()

def main():
    ap = argparse.ArgumentParser(prog="lab-know-seed")
    ap.add_argument("--commit", action="store_true", help="actually insert (default: preview only)")
    ap.add_argument("--posts", action="store_true", help="only meeting posts")
    ap.add_argument("--decisions", action="store_true", help="only decisions/ (branch extraction)")
    ap.add_argument("--branches", action="store_true",
                    help="regenerate the DEPRECATED branch layer from decisions/. OFF by default since "
                         "2026-08-20: every generated row had zero claims and the names were slugify "
                         "artifacts; aims carry the structure now. Kept so it stays recoverable.")
    ap.add_argument("--no-board", dest="no_board", action="store_true", help="skip BOARD.md notes")
    ap.add_argument("--board-days", dest="board_days", type=int, default=BOARD_DAYS,
                    help=f"only board notes from the last N days (default {BOARD_DAYS}; 0 = all)")
    ap.add_argument("--limit", type=int, default=0, help="cap files (for a quick look)")
    a = ap.parse_args()
    do_posts = a.posts or not a.decisions
    # BRANCH layer DEPRECATED 2026-08-20 (manager-recommended, Zac-consulted): the nightly maint was
    # regenerating 15 branch rows that no claim referenced, with slugify-mangled names, from ONE file's
    # "## BRANCH" headings. Opt-in only now — otherwise any cleanup silently undid itself at 08:21.
    do_dec   = a.branches and (a.decisions or not a.posts)
    do_board = not a.no_board and not a.posts and not a.decisions   # board is part of the full default seed

    skips, claims, branches = [], [], []
    if do_posts:
        posts = sorted(glob.glob(os.path.join(LAB, "meeting", "*", "posts", "*.md")))
        if a.limit: posts = posts[:a.limit]
        for p in posts:
            cs, _ = extract_from_post(p, skips); claims += cs
    if do_dec:
        decs = sorted(glob.glob(os.path.join(LAB, "decisions", "*.md")))
        for p in decs:
            branches += extract_branches(p, skips)
    if do_board:
        claims += extract_board(os.path.join(LAB, "BOARD.md"), skips, a.board_days)

    # drop parser-debris fragments, then dedup within this run
    seen, uniq = set(), []
    for c in claims:
        if is_fragment(c["statement"]):
            skips.append(f"fragment skipped (parser debris): '{c['statement'][:48]}' [{c['source']}]"); continue
        k = (c["statement"], c["source"])
        if k in seen: continue
        seen.add(k); uniq.append(c)
    claims = uniq
    bseen, buniq = set(), []
    for b in branches:
        if b["name"] in bseen: continue
        bseen.add(b["name"]); buniq.append(b)
    branches = buniq

    print(f"SEED {'COMMIT' if a.commit else 'PREVIEW'} — {len(claims)} claim candidates, "
          f"{len(branches)} branch candidates, {len(skips)} skipped\n")
    if a.commit:   # visibility guard: make the target DB explicit so a test can never silently hit prod
        db = os.path.join(LAB, "knowledge.db")
        print(f"  >>> COMMITTING to {db}" + ("   ⚠ THIS IS THE REAL LAB DB" if os.path.realpath(LAB) == os.path.realpath(os.path.join(HOME, "lab")) else "") + "\n")
    n_ret = sum(1 for c in claims if c["status"] == "retracted")
    print(f"  claims: {n_ret} retracted (from retraction tables), {len(claims)-n_ret} open (unconfirmed)\n")

    if not a.commit:
        print("=== CLAIM CANDIDATES (nothing written) ===")
        for c in claims[:120]:
            print(f"  [{c['status']:<9}] {c['statement'][:88]}")
            print(f"       setting: {c['setting'][:70]}  · {c['source']}" +
                  (f"  · {c['status_reason'][:50]}" if c.get('status_reason') else ""))
        if len(claims) > 120: print(f"  … +{len(claims)-120} more")
        print("\n=== BRANCH CANDIDATES ===")
        for b in branches:
            print(f"  [{b['status']:<6}] {b['name']:<34} {b['mechanism'][:44]}  ({b['source']})")
        print("\n=== SKIPPED (coverage — NOT ingested) ===")
        for s in skips[:40]: print(f"  - {s}")
        if len(skips) > 40: print(f"  … +{len(skips)-40} more")
        print("\nReview, then re-run with --commit. Nothing was written.")
        return

    dbkeys = existing_keys()
    ok = dup = failc = okb = 0
    for c in claims:
        if (c["statement"], c["source"]) in dbkeys: dup += 1; continue
        good, msg = commit_claim(c)
        if good: ok += 1
        else: failc += 1; print(f"  FAIL claim: {c['statement'][:50]} :: {msg[:80]}")
    for b in branches:
        good, msg = commit_branch(b)
        if good: okb += 1
        else: print(f"  FAIL branch: {b['name']} :: {msg[:80]}")
    print(f"committed: {ok} claims ({dup} already present, {failc} failed), {okb} branches")

if __name__ == "__main__":
    main()
