#!/usr/bin/env bash
# lab-agents-refresh (`lab refresh`) — STOP sessions so they can be resumed onto a new Claude Code build.
#
#   lab refresh --all              stop every live session (except the one running this)
#   lab refresh poreior wet-lab    stop the named sessions
#   lab refresh --all --dry-run    show what would be stopped
#
# Then resume each one from the agents view (`claude agents`). A resumed STOPPED session continues
# under the SAME id, on whatever binary the launcher now points at — that is the refresh.
#
# Why only the stop half: a running process cannot swap its own executable, and clicking back into a
# LIVE session in the agents view just re-attaches to the old process. So the one thing that needs
# doing from the command line is stopping them. The resume half was tried from a script twice and was
# wrong both ways: `--bg --remote-control --name` forks a COPY under a new id; bare
# `--resume <id> "<prompt>"` runs in the FOREGROUND and blocks forever with no TTY (it hung a real run
# on 2026-09-22 and stranded a session). The agents view resumes with each session's own saved
# options and is known to work, so it owns that half.
set -uo pipefail
JOBS="$HOME/.claude/jobs"
DRY=0; ALL=0; WANT=()
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=1;; --all) ALL=1;; -h|--help) sed -n '2,17p' "$0"; exit 0;;
    *) WANT+=("$(echo "$a" | tr 'A-Z' 'a-z')");;
  esac
done
[ "$ALL" = 1 ] || [ ${#WANT[@]} -gt 0 ] || { echo "name the sessions, or --all"; exit 1; }

live_ids() { timeout 60 claude agents --json 2>/dev/null | python3 -c \
  "import json,sys; print(' '.join(x.get('id','') for x in json.load(sys.stdin)))" 2>/dev/null; }

# The session running this command, if any. Stopping it would kill the script mid-loop and leave the
# rest untouched, so it is skipped and named at the end for you to stop last.
SELF_SID="$(basename "${CLAUDE_JOB_DIR:-}" 2>/dev/null)"

LIVE=" $(live_ids) "
[ "$LIVE" = "  " ] && { echo "lab refresh: could not read the live session list (claude agents failed)"; exit 1; }

targets=(); names=(); skipped_self=""; n_husk=0
for d in "$JOBS"/*/; do
  sid=$(basename "$d")
  if [ ! -f "$d/state.json" ]; then n_husk=$((n_husk+1)); continue; fi
  case "$LIVE" in *" $sid "*) ;; *) continue;; esac          # only LIVE sessions need stopping
  # TAB-separated: names can contain spaces.
  IFS=$'\t' read -r name _ < <(python3 -c "
import json;d=json.load(open('$d/state.json'));print((d.get('name') or '?')+chr(9))" 2>/dev/null)
  lname=$(echo "$name" | tr 'A-Z' 'a-z')
  if [ "$ALL" != 1 ]; then
    hit=0; for w in "${WANT[@]}"; do [ "$w" = "$lname" ] && hit=1; done
    [ "$hit" = 1 ] || continue
  fi
  if [ -n "$SELF_SID" ] && [ "$sid" = "$SELF_SID" ]; then skipped_self="$name ($sid)"; continue; fi
  targets+=("$sid"); names+=("$name")
done

if [ ${#targets[@]} -eq 0 ]; then
  echo "lab refresh: nothing live to stop${skipped_self:+ (only this session, $skipped_self)}"; exit 0
fi

for i in "${!targets[@]}"; do
  echo "== ${names[$i]} (${targets[$i]})$([ "$DRY" = 1 ] && echo '  — would stop')"
done
[ "$DRY" = 1 ] && { [ -n "$skipped_self" ] && echo "(skipping this session: $skipped_self)"; exit 0; }

# Stop all first, then verify ONCE per poll across all of them — not a full listing per session.
for sid in "${targets[@]}"; do timeout 60 claude stop "$sid" >/dev/null 2>&1 & done
wait

pending=("${targets[@]}")
for _ in $(seq 1 12); do
  now=" $(live_ids) "; still=()
  for sid in "${pending[@]}"; do case "$now" in *" $sid "*) still+=("$sid");; esac; done
  pending=("${still[@]}")
  [ ${#pending[@]} -eq 0 ] && break
  sleep 5
done

echo
for i in "${!targets[@]}"; do
  sid=${targets[$i]}; st="STOPPED"
  for p in "${pending[@]}"; do [ "$p" = "$sid" ] && st="STILL LIVE — stop failed, not safe to resume"; done
  printf "  %-9s %-34s %s\n" "$sid" "${names[$i]}" "$st"
done
echo
echo "Now resume each STOPPED session from the agents view:  claude agents"
echo "(same id comes back, on the new binary)"
[ -n "$skipped_self" ] && echo "Not stopped: $skipped_self — the session running this. Stop it last, then resume it."
[ "$n_husk" -gt 0 ] && echo "($n_husk job record(s) skipped: no state.json)"
[ ${#pending[@]} -eq 0 ]
