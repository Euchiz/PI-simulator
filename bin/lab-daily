#!/usr/bin/env bash
# lab-daily — daily lab health check. Gathers facts, asks the lab-manager (headless
# claude) to judge what's worth flagging, writes HEALTH.md, and alerts only on issues.
SELF="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
set -uo pipefail
export HOME="${HOME:?}"
export LAB_HOME="${LAB_HOME:-$HOME/lab}"
# A syntax error here must not brick every command, so validate before sourcing.
if [ -f "$LAB_HOME/lab.env" ]; then
  if bash -n "$LAB_HOME/lab.env" 2>/dev/null; then set -a; . "$LAB_HOME/lab.env"; set +a
  else echo "lab: WARNING — $LAB_HOME/lab.env has a syntax error and was IGNORED (values with spaces need quotes). Check: bash -n $LAB_HOME/lab.env" >&2; fi
fi

# Standalone health job, NOT a Claude session: if launched from one (`lab health` in a
# session) don't inherit its identity, or resolve_self would sign the alert with the
# launcher's name instead of the health job's.
unset CLAUDE_JOB_DIR CLAUDE_CODE_SESSION_ID
export PATH="$HOME/.local/bin:$SELF:/usr/local/bin:/usr/bin:/bin"
TS="$(date +%Y-%m-%d)"
LOG="$LAB_HOME/HEALTH.md"

FACTS="$(python3 "$SELF/lab-healthcheck" 2>&1)"

# Node + compute facts (the technician's domain). Cheap and safe — no tree walks; each
# potentially-blocking call is timeout-guarded so a stale NFS mount cannot hang the check.
# Which filesystems to watch is configurable (defaults: $HOME + external-reviewer scratch).
LAB_NODE_FS="${LAB_NODE_FS:-$HOME${LAB_EXT_WORK:+ $LAB_EXT_WORK}}"
node_facts() {
  echo "## Node / compute  ($(hostname 2>/dev/null))"
  local l1 l5 l15 rest
  read -r l1 l5 l15 rest < /proc/loadavg 2>/dev/null || true
  # /proc/loadavg is NODE-WIDE (all tenants); `nproc` inside a Slurm cgroup reports only OUR
  # allocated cores. On a login node they coincide; under an allocation they differ ~10x, so the
  # judge saw "load 39 on 8 cores" and escalated a node that was 50% idle across its 80 cores.
  local phys mine pct
  phys="$(nproc --all 2>/dev/null || echo '?')"
  mine="$(nproc 2>/dev/null || echo '?')"
  if [ -n "${SLURM_JOB_ID:-}" ]; then
    pct="?"; [ "$phys" != "?" ] && pct="$(awk -v l="${l1:-0}" -v c="$phys" 'BEGIN{printf "%.0f", l/c*100}')"
    echo "  load 1/5/15: ${l1:-?} ${l5:-?} ${l15:-?}   node has $phys cores (${pct}% utilised, SHARED with other users)"
    echo "  our slice:   $mine cores / ${SLURM_MEM_PER_NODE:-?} MB in Slurm job ${SLURM_JOB_ID} - cgroup-enforced, so other tenants' load is NOT our problem"
  else
    echo "  load 1/5/15: ${l1:-?} ${l5:-?} ${l15:-?}   cores: $phys"
  fi
  free -h 2>/dev/null | awk '/^Mem:/{print "  mem: "$3" used / "$2" total"}'
  local fs
  for fs in $LAB_NODE_FS; do
    [ -e "$fs" ] || continue
    timeout 10 df -hP "$fs" 2>/dev/null | awk 'NR==2{printf "  disk %-30s %s used, %s free\n", $6, $5, $4}'
  done
  command -v nvidia-smi >/dev/null 2>&1 &&
    timeout 10 nvidia-smi --query-gpu=index,utilization.gpu,memory.used,memory.total --format=csv,noheader 2>/dev/null |
      awk '{print "  gpu "$0}'
  return 0
}
FACTS="$FACTS

$(node_facts)"

read -r -d '' INSTR <<'EOF' || true
You are running the lab's DAILY health check. It covers two things: the coordination
blackboard (Claude coding sessions sharing it) and the compute NODE it all runs on.
Below is today's machine-gathered data. Decide whether anything is genuinely worth
pulling attention to. Be conservative: a session freshly "working" or cleanly "done"
is fine and needs no flag.
Worth flagging (coordination): a session marked working but untouched >24h (possibly
stalled), blocked/failed/errored states that look stuck, a session waiting on a message
that isn't coming, unread inbox backlog, or board items aging unresolved.
A `lab note` / board broadcast is an ANNOUNCEMENT, not an outstanding ask — never read a
session as "blocked waiting on a reply" because it posted a finding to the board. Infer
"waiting on a reply" ONLY from an actual unanswered DIRECT message (an ask sent to a
specific inbox), never from a blocked state alone: a session frequently reads as "blocked"
just because its turn ended, not because it is stuck. When a block's cause is unclear,
phrase it as "verify whether X is really blocked", not as a definite waiting-on-reply.
Worth flagging (node/compute): a disk over ~90% full or nearly out of free space,
sustained load far above the core count, memory near exhaustion, a GPU error, or an
external-reviewer daemon that is DOWN.

Respond in EXACTLY one of two forms, nothing else:
- If nothing needs attention:  OK: <6-12 word summary>
- If something does:  first line exactly "FLAG", then 2-5 terse bullets ("- ..."),
  each naming one concern AND why it matters / what to do. No preamble.

HEALTH DATA:
EOF

# The judgement pass is optional and model-agnostic: set LAB_JUDGE=0 to skip it
# (you still get the raw facts), or point LAB_JUDGE_CMD at any prompt-in/text-out CLI.
if [ "${LAB_JUDGE:-1}" = "0" ]; then
  VERDICT=""
else
  VERDICT="$(printf '%s\n%s\n' "$INSTR" "$FACTS" \
    | ${LAB_JUDGE_CMD:-claude -p --model ${LAB_JUDGE_MODEL:-sonnet}} 2>/dev/null)"
fi
[ -n "$VERDICT" ] || VERDICT="OK: (judgment unavailable — see heuristic flags in data below)"

{
  echo "# Lab health — $(date '+%Y-%m-%d %H:%M %Z')"
  echo
  echo "$VERDICT"
  echo
  echo "<details><summary>raw health data</summary>"
  echo
  echo '```'
  echo "$FACTS"
  echo '```'
  echo "</details>"
} > "$LOG"

# Alert only when flagged. The daily check is the TECHNICIAN's to act on, so deliver the
# flag to their inbox (falling back to the manager if no technician is configured).
if printf '%s' "$VERDICT" | head -1 | grep -qiE '^FLAG'; then
  mkdir -p "$LAB_HOME/alerts"
  cp "$LOG" "$LAB_HOME/alerts/$TS.md"
  SUMMARY="$(printf '%s' "$VERDICT" | tail -n +2 | head -6)"
  HEALTH_TO="${LAB_TECHNICIAN:-${LAB_MANAGER:-lab-manager}}"
  LAB_FROM="lab-health" "$SELF/lab" send --force "$HEALTH_TO" "health check — issues to review ($TS)" \
    "$SUMMARY

Full report: $LAB_HOME/HEALTH.md" >/dev/null 2>&1 || true
  # Also fire the pluggable desktop alert if one is configured (notify-send needs a desktop).
  ${LAB_ALERT_CMD:-notify-send} "Lab health: issues to review" "$SUMMARY" 2>/dev/null || true
  echo "[$(date)] FLAGGED -> alerts/$TS.md -> $HEALTH_TO" >> "$LAB_HOME/alerts/.runlog"
else
  echo "[$(date)] OK" >> "$LAB_HOME/alerts/.runlog" 2>/dev/null || { mkdir -p "$LAB_HOME/alerts"; echo "[$(date)] OK" >> "$LAB_HOME/alerts/.runlog"; }
fi
