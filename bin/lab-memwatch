#!/usr/bin/env bash
# lab-memwatch — node-RAM watchdog for cron. When memory is critically high, find the
# top consumer, attribute it to a lab agent (its process env carries CLAUDE_JOB_DIR ->
# job-id -> roster name), and warn THAT agent to move heavy compute off the login node.
# Cheap when memory is fine (a single /proc/meminfo read, then exit). Rate-limited per
# agent. Session backends (no CLAUDE_JOB_DIR), operators, and desktop apps that merely
# inherited the env var (a browser viewing an artifact) are never warned; a detached
# compute job that outlived its tool call still is (comm allowlist, not parent chain).
#
# Env (via $LAB_HOME/lab.env): LAB_MEM_WARN_PCT (default 90), LAB_MEM_COOLDOWN_MIN (30).
# Test: LAB_MEMWATCH_DRYRUN=1 [LAB_MEM_WARN_PCT=50] lab-memwatch  (prints, never sends).
set -uo pipefail
LAB="${LAB_HOME:-$HOME/lab}"
[ -f "$LAB/lab.env" ] && { set -a; . "$LAB/lab.env" 2>/dev/null || true; set +a; }
THRESH="${LAB_MEM_WARN_PCT:-90}"
COOLDOWN_MIN="${LAB_MEM_COOLDOWN_MIN:-30}"
DRY="${LAB_MEMWATCH_DRYRUN:-0}"
ROSTER="$LAB/.roster.tsv"
DIR="$LAB/.memwatch"; mkdir -p "$DIR"
LOG="$DIR/memwatch.log"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }
log() { echo "$(ts) $*" >> "$LOG"; }

# 1) cheap gate — memory used% from MemAvailable
used=$(awk '/^MemTotal/{t=$2}/^MemAvailable/{a=$2}END{printf "%d",(t-a)*100/t}' /proc/meminfo)
if [ "${used:-0}" -lt "$THRESH" ]; then
  [ "$DRY" = 1 ] && echo "mem ${used}% < ${THRESH}% — nothing to do"
  exit 0
fi

OPS=" ${LAB_MANAGER:-lab-manager} ${LAB_TECHNICIAN:-} "

# A real session compute job traces up to a Claude session backend (comm "2.1.*"/"claude").
# A process that merely INHERITED CLAUDE_JOB_DIR but reparents to systemd --user — e.g. a desktop
# browser opened to view a published artifact — is NOT a job to warn about. Require a session-
# backend ancestor so we don't finger browsers/desktop apps that happen to carry the env var.
traces_to_backend() {
  local q="$1" name hops=0
  while [ "$hops" -lt 16 ] && [ -n "$q" ] && [ "$q" != 1 ] && [ -r "/proc/$q/status" ]; do
    name=$(awk '/^Name:/{print $2; exit}' "/proc/$q/status" 2>/dev/null)
    case "$name" in 2.1.*|claude) return 0;; esac
    q=$(awk '/^PPid:/{print $2; exit}' "/proc/$q/status" 2>/dev/null)
    hops=$((hops+1))
  done
  return 1
}

# Unambiguous compute tools we WILL warn about even when DETACHED (backgrounded past the tool call
# that launched them, so they no longer trace to a backend but a live agent still owns them). An
# ALLOWLIST, not a denylist: it fails CLOSED, so a GUI app nobody enumerated is never warned — the
# exact firefox-class false positive this replaces (ont-fm 2026-08-14). Deliberately EXCLUDES
# java/node: those are also IDEs/Electron apps, so they only warn via the traces_to_backend path
# (a confirmed live session), never via detached attribution. Extend with LAB_MEM_COMPUTE_COMMS.
COMPUTE_COMMS="python python3 pypy R Rscript julia perl ruby samtools bcftools bedtools tabix bgzip minimap2 bwa bowtie2 hisat2 STAR salmon kallisto dorado guppy nanopolish f5c pod5 aws prefetch fasterq-dump fastq-dump gzip pigz zstd xz bzip2 lz4 sort gawk cutadapt fastp seqkit ${LAB_MEM_COMPUTE_COMMS:-}"
is_compute_comm() {
  local c="$1"
  case " $COMPUTE_COMMS " in *" $c "*) return 0;; esac
  case "$c" in python3.*|python2.*|Python) return 0;; esac   # versioned python (python3.11, …)
  return 1
}

# 2) top consumers by RSS+swap (kb), biggest first (prefilter by RSS, cap the work)
mapfile -t TOP < <(
  for pid in $(ps -eo pid= --sort=-rss 2>/dev/null | head -40); do
    [ -r "/proc/$pid/status" ] || continue
    awk -v p="$pid" '/^VmRSS/{r=$2}/^VmSwap/{s=$2}END{print (r+s)+0, p}' "/proc/$pid/status" 2>/dev/null
  done | sort -rn | head -12
)

# 3) biggest consumer attributable to a current, non-operator agent
top_desc=""; c_pid=""; c_kb=0; c_job=""; c_agent=""
for row in "${TOP[@]}"; do
  kb=${row%% *}; pid=${row##* }
  [ -n "$top_desc" ] || top_desc="$(ps -o comm= -p "$pid" 2>/dev/null | tr -d ' ') pid=$pid $((kb/1024))MB"
  job=$( { tr '\0' '\n' < "/proc/$pid/environ"; } 2>/dev/null | grep -oE 'CLAUDE_JOB_DIR=.*/jobs/[0-9a-f]+' | grep -oE '[0-9a-f]+$' | head -1)
  [ -n "$job" ] || continue
  agent=$(awk -v j="$job" -F'\t' '$1==j{print $2}' "$ROSTER" 2>/dev/null)
  [ -n "$agent" ] || continue
  # Accept if it's live session compute (traces to a backend — warn regardless of comm, so an unusual
  # live tool is still caught) OR a DETACHED but unambiguous compute tool (backgrounded past its tool
  # call — a live agent still owns it). Reject a detached NON-compute process (a browser that merely
  # inherited the env var). This is the two-questions fix: "does it have an owner?" (env, already
  # answered above) is separate from "is it a job vs a desktop app?" (comm/backend, answered here).
  pcomm="$(ps -o comm= -p "$pid" 2>/dev/null | tr -d ' ')"
  case "$pcomm" in 2.1.*|claude)   # the session backend itself — baseline infra, not movable compute
    [ "$DRY" = 1 ] && echo "skip: pid=$pid ($pcomm) is a session backend (baseline, not movable) -> $agent"
    continue;; esac
  if traces_to_backend "$pid"; then
    [ "$DRY" = 1 ] && echo "live-backend compute: pid=$pid ($pcomm) -> $agent"
  elif is_compute_comm "$pcomm"; then
    [ "$DRY" = 1 ] && echo "detached compute-comm ($pcomm): pid=$pid -> $agent owns a backgrounded job"
  else
    [ "$DRY" = 1 ] && echo "skip: pid=$pid ($pcomm) carries $agent's env but is detached and not a known compute tool — not a job to warn about"
    continue
  fi
  [ "$DRY" = 1 ] && echo "attributed: pid=$pid $((kb/1024))MB -> job=$job agent=$agent ($pcomm)"
  case "$OPS" in *" $agent "*) [ "$DRY" = 1 ] && echo "  ($agent is an operator — skip)"; continue;; esac
  c_pid=$pid; c_kb=$kb; c_job=$job; c_agent=$agent; break
done

mb=$((c_kb/1024))
if [ -z "$c_agent" ]; then
  log "mem=${used}% — no agent-attributable top consumer (top: ${top_desc:-?}); logged only"
  [ "$DRY" = 1 ] && echo "no non-operator agent attributable; would log only"
  exit 0
fi

# 4) rate-limit per agent
stamp="$DIR/$c_agent.last"; nowe=$(date +%s)
if [ -f "$stamp" ] && [ $(( nowe - $(cat "$stamp" 2>/dev/null || echo 0) )) -lt $((COOLDOWN_MIN*60)) ]; then
  log "mem=${used}% — $c_agent top (${mb}MB pid=$c_pid) but within ${COOLDOWN_MIN}m cooldown; not re-sent"
  [ "$DRY" = 1 ] && echo "$c_agent within cooldown; would not re-send"
  exit 0
fi

# 5) warn the agent
proc="$(ps -o comm= -p "$c_pid" 2>/dev/null | tr -d ' ')"
args="$(ps -o args= -p "$c_pid" 2>/dev/null | cut -c1-100)"
subj="⚠ node RAM ${used}% — your job is the top memory consumer; please move heavy compute to SLURM"
body="Automated node-health warning (technician mem-watch). The shared login node is at ${used}% RAM used (threshold ${THRESH}%). Your session's process is the single largest consumer right now:
  pid=$c_pid  ${mb}MB (RSS+swap)  $proc
  $args
Heavy compute on this 5.8 GB shared login node degrades it for every session. Please run it on a SLURM node (srun/sbatch) and/or trim its footprint. If it's a short bounded run that will finish on its own, you can ignore this."

if [ "$DRY" = 1 ]; then
  echo "WOULD SEND -> $c_agent (job $c_job):"; echo "  subj: $subj"; echo "  ${mb}MB pid=$c_pid $proc"
  exit 0
fi
# deliver by roster NAME (name-keyed inboxes; @jobid lands in a dir the session never reads)
"$SELF/lab" send --force "$c_agent" "$subj" "$body" >> "$LOG" 2>&1
echo "$nowe" > "$stamp"
log "mem=${used}% — WARNED $c_agent (@$c_job): ${mb}MB pid=$c_pid $proc"
