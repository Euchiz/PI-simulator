#!/usr/bin/env bash
# lab-msg — messaging between sessions: send · broadcast · inbox · read · watch.
# Part of the `lab` family; normally reached as `lab send`, `lab read`, etc.
set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/lab-common.sh"

cmd_send() {
  ensure_init
  local force=0
  if [ "${1:-}" = "--force" ]; then force=1; shift; fi
  local to_raw="${1:?usage: lab send [--force] <to|@job-id> <subject> [body]}"; local subj="${2:?need subject}"; shift 2 || true
  local body="${*:-}"; [ -n "$body" ] || { [ -t 0 ] || body="$(cat)"; }
  # validate the recipient against the active messenger list (unless --force)
  local to
  if [ "$force" = 1 ]; then
    to="$(pkey "${to_raw#@}")"
  else
    to="$(python3 "$SELF/lab-roster" resolve "$to_raw")" \
      || { echo "lab send: recipient not sent to. Pick a current target above, or use \`lab who\`, \`@<job-id>\`, or --force." >&2; return 1; }
  fi
  local from; from="$(resolve_self || true)"; from="$(pkey "${from:-${LAB_FROM:-$(project_for_dir || echo unknown)}}")"
  mkdir -p "$INBOX/$to"
  [ -d "$INBOX/$to" ] || die "no inbox for '$to' — register it first"
  local f="$INBOX/$to/$(stamp)__from-$(slug "$from")__$(slug "$subj").md"
  cat > "$f" <<EOF
---
from: $from
to: $to
date: $(ts)
subject: $subj
status: unread
---

$body
EOF
  echo "lab: message -> $to  ($(basename "$f"))"
}

cmd_broadcast() {
  ensure_init
  local subj="${1:?usage: lab broadcast <subject> <body>}"; shift || true
  local body="${*:-}"; [ -n "$body" ] || { [ -t 0 ] || body="$(cat)"; }
  [ -n "$body" ] || die "usage: lab broadcast <subject> <body>|<stdin>"
  local sent=0
  while read -r key; do
    [ -n "$key" ] || continue
    cmd_send --force "$key" "$subj" "$body" >/dev/null   # fan-out: reach every registered inbox
    sent=$((sent+1))
  done < <(grep '^- \*\*' "$REG" 2>/dev/null | sed -E 's/^- \*\*([^*]+)\*\*.*/\1/')
  echo "lab: broadcast to $sent sessions — \"$subj\""
}

cmd_inbox() {
  ensure_init
  if [ -n "${1:-}" ]; then
    local n; n="$(pkey "$1")"; local c; c=$(find "$INBOX/$n" -maxdepth 1 -name '*.md' 2>/dev/null | wc -l)
    echo "$n: $c unread"
  else
    for d in "$INBOX"/*/; do
      [ -d "$d" ] || continue; local n; n=$(basename "$d")
      local c; c=$(find "$d" -maxdepth 1 -name '*.md' 2>/dev/null | wc -l)
      [ "$c" -gt 0 ] && echo "$n: $c unread"
    done
  fi
}

cmd_read() {
  ensure_init
  reconcile_self   # if this session was renamed, its mail follows it before we read
  local self; self="$(pkey "$(resolve_self || true)")"
  local n; n="$(pkey "${1:-$self}")"; [ -n "$n" ] || die "usage: lab read <project>"
  # Only CONSUME your OWN inbox. Reading someone ELSE's inbox PEEKS (shows, leaves unread): on
  # 2026-08-13 a background poll running `lab read manager` from another session consumed the
  # manager's mail and a message stalled 13h. A cross-inbox read must NEVER mark another's mail read.
  local consume=1
  [ -n "${1:-}" ] && [ "$n" != "$self" ] && consume=0
  local any=0
  mkdir -p "$INBOX/$n/.read"   # ad-hoc inboxes (e.g. codex replies to an unregistered name) lack it
  for f in "$INBOX/$n"/*.md; do
    [ -e "$f" ] || continue; any=1
    echo "════════════════════════════════════════"
    # crash-safe ordering: a message is moved to .read ONLY AFTER it prints in full. If cat fails
    # or is interrupted, it stays in the inbox for the next read (an unseen message must never be
    # silently consumed — the 2026-08-19 loss class). mv failure also leaves it unread.
    if cat "$f"; then
      echo
      [ "$consume" = 1 ] && { mv "$f" "$INBOX/$n/.read/" 2>/dev/null || true; }
    fi
  done
  # Forget announcements for mail that is no longer unread, so the list cannot grow forever.
  if [ "$consume" = 1 ] && [ -f "$INBOX/$n/.watch-announced" ]; then
    local keep=""; for f in "$INBOX/$n"/*.md; do [ -e "$f" ] && keep+="$(basename "$f")"$'\n'; done
    printf '%s' "$keep" > "$INBOX/$n/.watch-announced"
  fi
  if [ "$consume" = 1 ] && [ ! -f "$LAB_HOME/.watch-disabled" ]; then
    echo "↻ re-arm live delivery: run  lab watch  as a BACKGROUND command (Bash, run_in_background: true)"
  fi
  if [ "$any" != 1 ]; then echo "[$n] inbox empty"
  elif [ "$consume" = 0 ]; then
    echo "(peeked '$n' — NOT your inbox, so its mail is left UNREAD; only the owner's own \`lab read\` consumes it)"
  fi
}

# Emit one line describing a message file (stdout line = one Monitor event).
watch_emit() {
  local f="$1"; [ -f "$f" ] || return 0
  local from subj
  from="$(sed -n 's/^from: //p' "$f" | head -1)"
  subj="$(sed -n 's/^subject: //p' "$f" | head -1)"
  echo "NEW lab message — from ${from:-?}: ${subj:-(no subject)}  → run: ~/lab/bin/lab read"
}

# ONE-SHOT watcher: waits for the next unannounced message, prints it, and EXITS.
#
# Run it as a BACKGROUND command (Bash tool, run_in_background: true). The harness wakes the session
# when it exits, so the session is woken exactly once per arrival and costs nothing while idle.
#
# Why not the old endless loop under Monitor: Claude Code 2.1.280 caps Monitor at 30 minutes even
# when persistent is requested, so an endless watcher expired every half hour and every session spent
# a turn re-arming it. Background commands are not capped (verified 2026-09-22: armed 18:20:53, fired
# 18:55:54 on a message sent 35 min later, 1 s after it landed).
#
# NOTHING IS MISSED BETWEEN ARMINGS. "Unread" is simply a *.md file still in the inbox (lab read
# moves them to .read/). A new watcher fires IMMEDIATELY if any unread message it has not already
# announced is present -- so mail that arrived while the agent was replying is caught the instant it
# re-arms. Announced-but-unread messages are remembered in .watch-announced so re-arming does not
# re-fire on them in a loop.
#
# Cheap by construction: one `ls` of ONE tiny inbox dir per poll, never a scan. ~/lab is NFS and
# inotify is unreliable there, hence polling.
cmd_watch() {
  ensure_init
  reconcile_self   # pick up a rename before we start watching an inbox
  local n; n="$(pkey "${1:-$(resolve_self || true)}")"
  [ -n "$n" ] || die "usage: lab watch   (run inside a registered session)"
  local dir="$INBOX/$n"; mkdir -p "$dir"
  local interval="${LAB_WATCH_INTERVAL:-30}"

  # KILL SWITCH: $LAB_HOME/.watch-disabled turns live delivery off lab-wide.
  local off="$LAB_HOME/.watch-disabled"
  if [ -f "$off" ]; then
    echo "lab watch: live delivery is DISABLED lab-wide ($off). Do not re-arm. Check mail with: lab read"
    return 0
  fi

  # --- one waiter per session -------------------------------------------------
  # same session + alive -> genuine duplicate, exit (tell the agent nothing needs doing)
  # other session / dead pid -> stale, take over
  local lockdir="$LAB_HOME/.watch"; mkdir -p "$lockdir"
  local lock="$lockdir/$n.lock" old_pid old_sid
  local my_sid="${CLAUDE_CODE_SESSION_ID:-unknown}"
  if [ -f "$lock" ]; then
    read -r old_pid old_sid < "$lock" 2>/dev/null || true
    if [ -n "${old_pid:-}" ] && [ "$old_pid" != "$$" ] && kill -0 "$old_pid" 2>/dev/null \
       && [ "${old_sid:-}" = "$my_sid" ]; then
      echo "lab watch: already armed for '$n' (pid $old_pid) — nothing to do."
      return 0
    fi
  fi
  printf '%s %s\n' "$$" "$my_sid" > "$lock"
  # Expand $lock NOW: the one-shot watcher RETURNS normally, so the EXIT trap fires after this
  # function's locals are gone, and under `set -u` a late "$lock" is an unbound-variable error --
  # exit 1, which the harness reports as a FAILED task even though mail was delivered.
  trap "rm -f '$lock' 2>/dev/null" EXIT INT TERM
  # ---------------------------------------------------------------------------

  local ann="$dir/.watch-announced"; touch "$ann"
  local f fresh
  while true; do
    [ -f "$off" ] && { echo "lab watch: live delivery DISABLED lab-wide — exiting. Check mail with: lab read"; return 0; }
    fresh=()
    for f in "$dir"/*.md; do
      [ -e "$f" ] || continue
      grep -qxF "$(basename "$f")" "$ann" 2>/dev/null || fresh+=("$f")
    done
    if [ ${#fresh[@]} -gt 0 ]; then
      for f in "${fresh[@]}"; do watch_emit "$f"; basename "$f" >> "$ann"; done
      echo "Next: lab read   (it prints the re-arm command when it is done)"
      return 0
    fi
    sleep "$interval"
  done
}

cmd="${1:-}"; shift || true
case "$cmd" in
  send)           cmd_send "$@";;
  broadcast)      cmd_broadcast "$@";;
  inbox)          cmd_inbox "$@";;
  read)           cmd_read "$@";;
  watch)          cmd_watch "$@";;
  -h|--help|help) exec bash "$SELF/lab" help messaging;;
  *)              die "lab-msg: unknown '$cmd' (send|broadcast|inbox|read|watch)";;
esac
